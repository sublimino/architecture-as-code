    "error":{"type":"object","additionalProperties":false,"required":["schema_version","error_code","message","request_id"],"properties":{"schema_version":{"const":"1.0.0"},"error_code":{"enum":["malformed-request","unauthenticated","forbidden","conflict","payload-too-large","unsupported-media-type","validation-failed"]},"message":{"type":"string","minLength":1,"maxLength":256},"request_id":{"type":"string","pattern":"^[A-Za-z0-9-]{8,128}$"}}}
