{
  "name": "net-raw-added-back-lowercase",
  "level": "unit",
  "description": "drop: [ALL] then add: [net_raw] (lowercase). Runtimes upper-case capability names, so NET_RAW is granted: no-net-raw fails.",
  "input": {
    "object": {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "baseline-linux-compliant",
        "namespace": "payments"
      },
      "spec": {
        "automountServiceAccountToken": false,
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 10001,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "app",
            "image": "registry.example/app@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "ports": [
              {
                "name": "http",
                "containerPort": 8080,
                "protocol": "TCP"
              }
            ],
            "env": [
              {
                "name": "LOG_LEVEL",
                "value": "info"
              }
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ],
                "add": [
                  "net_raw"
                ]
              }
            }
          }
        ],
        "volumes": [
          {
            "name": "tmp",
            "emptyDir": {}
          }
        ]
      }
    },
    "agent": {},
    "request": {}
  },
  "expect": {
    "no-net-raw": "fail",
    "no-added-capabilities": "fail",
    "capabilities-dropped-all": "pass"
  }
}
