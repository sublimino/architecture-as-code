{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://signalloom.controlplane.io/contracts/external-agent-enrollment.v1.schema.json","title":"ExternalAgentEnrollmentV1","type":"object","additionalProperties":false,
  "required":["schema_version","agent_id","host_id","key_id","key_algorithm","public_key","client_nonce","credential_kind","credential_scope","credential_bootstrap","credential_reference"],
  "properties":{"schema_version":{"const":"1.0.0"},"agent_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,63}$"},"host_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,63}$"},"key_id":{"type":"string","pattern":"^[A-Za-z0-9._:-]{3,128}$"},"key_algorithm":{"const":"Ed25519"},"public_key":{"type":"string","pattern":"^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"},"client_nonce":{"type":"string","minLength":22,"maxLength":86,"pattern":"^[A-Za-z0-9_-]+$"},"credential_kind":{"const":"existing-mtls-identity"},"credential_scope":{"const":"audit-upload-only"},"credential_bootstrap":{"const":"pre-provisioned-out-of-band"},"credential_reference":{"type":"string","minLength":12,"maxLength":512,"pattern":"^spiffe://[A-Za-z0-9._~:/-]+$"}},
  "x-signalloom-semantics":{"tenant-source":"authenticated-principal","token-location":"Authorization: Bearer only","token-consumption":"single-use-atomic-compare-and-set","registration":"token-bound-pre-registered-agent-host-pair","credential-issuance":"none; enrollment binds an existing pre-provisioned mTLS identity and Ed25519 audit key","credential-private-material":"never accepted or returned","replay-result":"same-token-or-nonce-conflict"}
}
