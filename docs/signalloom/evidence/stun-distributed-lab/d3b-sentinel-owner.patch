+package main
+
+import (
+	"context"
+
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/client-go/kubernetes"
+)
+
+// ownerStunned (W6 lab patch) honours signalloom.io/stunned=true on the pod's controlling
+// ReplicaSet or its Deployment. API errors are returned, never read as "not stunned".
+func ownerStunned(cs kubernetes.Interface, pod *corev1.Pod) (bool, error) {
+	for _, ref := range pod.OwnerReferences {
+		if ref.Kind != "ReplicaSet" || ref.Controller == nil || !*ref.Controller {
+			continue
+		}
+		rs, err := cs.AppsV1().ReplicaSets(pod.Namespace).Get(context.TODO(), ref.Name, metav1.GetOptions{})
+		if err != nil {
+			return false, err
+		}
+		if rs.Annotations[labelStunnedIO] == "true" {
+			return true, nil
+		}
+		for _, o := range rs.OwnerReferences {
+			if o.Kind != "Deployment" {
+				continue
+			}
+			d, err := cs.AppsV1().Deployments(pod.Namespace).Get(context.TODO(), o.Name, metav1.GetOptions{})
+			if err != nil {
+				return false, err
+			}
+			return d.Annotations[labelStunnedIO] == "true", nil
+		}
+	}
+	return false, nil
+}
