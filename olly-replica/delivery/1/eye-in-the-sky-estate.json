          "showMiniMap": false
        },
        "content": "\n<canvas id=\"mx-rain\" style=\"position:fixed;inset:0;z-index:0;pointer-events:none;\"></canvas>\n<script>\n(function(){\n  if (window.__mxRain) return; window.__mxRain = true;\n  var c = document.getElementById('mx-rain');\n  document.body.insertBefore(c, document.body.firstChild);\n  var ctx = c.getContext('2d');\n  function size(){ c.width = window.innerWidth; c.height = window.innerHeight; }\n  size(); window.addEventListener('resize', size);\n  var glyphs = ('01011001'+'\\u30A2\\u30A6\\u30A8\\u30AB\\u30B5\\u30BF\\u30CA\\u30CF\\u30DE\\u30E9'+'0123456789ABCDEF').split('');\n  var fs = 14, cols = 0, drops = [];\n  function reset(){ cols = Math.floor(window.innerWidth/fs); drops = []; for (var i=0;i<cols;i++) drops[i] = Math.random()*-50; }\n  reset(); window.addEventListener('resize', reset);\n  function draw(){\n    ctx.fillStyle = 'rgba(5,7,10,0.075)'; ctx.fillRect(0,0,c.width,c.height);\n    ctx.font = fs+'px monospace';\n    for (var i=0;i<drops.length;i++){\n      var t = glyphs[Math.floor(Math.random()*glyphs.length)];\n      var y = drops[i]*fs;\n      ctx.fillStyle = Math.random() > 0.985 ? '#ccffdd' : '#00c853';\n      ctx.fillText(t, i*fs, y);\n      if (y > c.height && Math.random() > 0.975) drops[i] = 0;\n      drops[i] += 0.6;\n    }\n  }\n  setInterval(draw, 50);\n})();\n</script>\n\n<style>\nbody { background: #05070a !important; }\n.main-view, .dashboard-container, .scrollbar-view, .react-grid-layout,\n.page-dashboard, [class*=\"dashboard-content\"], [class*=\"DashboardScene\"] {\n  background: transparent !important;\n}\n#mx-rain { opacity: .45; }\nbody, .panel-content, [class*=\"panel\"] table, [role=\"grid\"] {\n  font-family: 'Cascadia Code','JetBrains Mono','SF Mono','Courier New',monospace !important;\n}\n.panel-container, [class*=\"panel-container\"], section[class*=\"panel\"] {\n  background: rgba(6,12,10,.92) !important;\n  border: 1px solid rgba(0,230,118,.30) !important;\n  box-shadow: 0 0 14px rgba(0,230,118,.10) !important; border-radius: 2px !important;\n}\n.panel-title, [class*=\"panel-title\"], [class*=\"PanelChrome\"] [class*=\"title\"] {\n  color: #00e676 !important; text-transform: uppercase; letter-spacing: 1.6px;\n  font-size: 12px !important; text-shadow: 0 0 6px rgba(0,230,118,.45);\n}\nth, [role=\"columnheader\"] {\n  color: #00e676 !important; text-transform: uppercase; letter-spacing: 1px;\n  border-color: rgba(0,230,118,.28) !important; background: rgba(0,230,118,.05) !important;\n}\ntd, [role=\"cell\"] { border-color: rgba(0,230,118,.10) !important; }\na, a:link { color: #00e5ff !important; }\n</style>\n\n<div style=\"background:#0b0f0d; border:1px solid #00e676; box-shadow:0 0 12px rgba(0,230,118,.25) inset; padding:10px 14px; font-family:'Cascadia Code','Courier New',monospace;\">\n  <div style=\"color:#00e676; font-size:18px; letter-spacing:2px; text-shadow:0 0 8px rgba(0,230,118,.6);\">&#9616; EYE IN THE SKY // ESTATE CONTROL</div>\n  <div style=\"color:#5f6b6b; font-size:12px; margin-top:4px;\">\n    Every managed service on one board. Rows link to the tenant view; ticket counts and Escalate open ServiceNow;\n    the SRE link (top right) drops into the drill-down control tower.\n  </div>\n</div>\n",
        "mode": "html"
      },
