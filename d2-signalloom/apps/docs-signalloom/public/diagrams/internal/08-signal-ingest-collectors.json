      "row": 0,
      "col": 0
    },
    {
      "id": "gcp",
      "label": "GCP audit logs",
      "sub": "gcpaudit",
      "kind": "external",
      "row": 0,
      "col": 1
    },
    {
      "id": "k8s",
      "label": "Kubernetes audit",
      "sub": "k8saudit",
      "kind": "external",
      "row": 0,
      "col": 2
    },
    {
      "id": "bao",
      "label": "OpenBao audit",
      "sub": "baoaudit",
      "kind": "external",
      "row": 1,
      "col": 0
    },
    {
      "id": "spire",
      "label": "SPIRE SVID issuance",
      "sub": "spirea",
      "kind": "external",
      "row": 1,
      "col": 1
    },
    {
      "id": "wss",
      "label": "Workspace SaaS",
      "sub": "Google Workspace / M365 (planned)",
      "kind": "optional",
      "row": 1,
      "col": 2
    },
    {
      "id": "registry",
      "label": "Collector registry",
      "sub": "collectors/registry.go",
