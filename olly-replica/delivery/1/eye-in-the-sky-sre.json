    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_OLLY-PROMETHEUS}"
      },
      "description": "Tenant health: live 5xx error rate from the app's own metrics (green <2%, amber <5%, red above). Click to open the inventory-service tenant dashboard.",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "links": [
            {
              "title": "Open inventory-service dashboard",
              "url": "/d/tenant-app-view/tenant-app-view?var-app=inventory-service"
            }
          ],
          "mappings": [],
          "max": 100,
          "min": 0,
          "noValue": "NO DATA",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value",
        "wideLayout": true
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "expr": "100 * sum(rate(tenant_app_requests_total{app_id=\"inventory-service\",code=\"500\"}[5m])) / clamp_min(sum(rate(tenant_app_requests_total{app_id=\"inventory-service\"}[5m])), 0.001)",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_OLLY-PROMETHEUS}"
          }
        }
      ],
      "title": "inventory-service",
      "type": "stat"
    },
