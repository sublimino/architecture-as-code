  "findings_remediated": {
    "NET-1 / LAT-9 (HIGH)": "ingress namespace: envoy-gateway metrics (19001) and control ports (18000/18001/18002/9443) restricted to same-namespace ingress; data-plane listeners (10080/10443) remain open to the world.",
    "NET-2 / LAT-4,LAT-6 (frontend->backend)": "backend namespace: blanket default-deny (Ingress+Egress) plus explicit allows for nats:4222 (all 3 frontend workers), postgres:5432 (osramp-archiver only), archivista:8082 (fe-signalloom only).",
    "NET-3 (frontend)": "frontend namespace: blanket default-deny (Ingress+Egress); zero ingress rules (pure outbound workers); explicit DNS/nats/postgres egress allows only.",
    "kagent-controller/kagent-ui/kagent-tools-metrics (checklist item, no formal ID)": "d2-signalloom/infra/kagent/base/networkpolicy.yaml: three new Ingress-only NetworkPolicies close the previously-uncovered ports (8083, 8080, 8085); Egress deliberately untouched (apiserver-watch risk).",
    "Missing ClientTrafficPolicy (checklist item, no formal ID)": "d2-infra/components/ingress/configs/base/clienttrafficpolicy.yaml: earlyRequestHeaders.remove strips client-supplied X-Forwarded-For/X-Real-IP; xForwardedFor.numTrustedHops=1 declares the trust boundary explicitly."
  },
  "deliberately_not_fixed": {
    "cpai, fe-k8s-afm": "Live namespaces with zero NetworkPolicy coverage, but owned by d2-cpai/d2-k8s-afm respectively -- neither is d2-infra/ nor d2-signalloom/infra/, so both are outside this card's merge boundary. Single pod each, advisory-tier per the SLAAT-P1-1 checklist. Left as a backlog item for a dedicated follow-up card.",
    "ingress, kagent (Egress)": "Deliberately scoped to Ingress-only (see networkpolicy.yaml header comments in both files) to avoid the card's own named hard-blocker: both namespaces run controllers that watch the whole cluster via the k8s apiserver (envoy-gateway's Gateway-API watch, kagent-controller's WATCH_NAMESPACES=\"\"), and the Envoy data-plane proxies to every tenant namespace the Gateway allows."
  },
