{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalloom.io/schemas/sler.signalloom.io/v1alpha1/sler-enforcement-wire-contract.json",
  "title": "SLER enforcement wire contract (FROZEN)",
  "description": "Machine-readable form of the SLER enforcement wire contract, frozen by SLER-P1-3 at sler.signalloom.io/v1alpha1. Normative prose: docs/signalloom/sler-p1-3-frozen-contract.md. Generated once from the Go types and thereafter static; d2-signalloom/apps/fleet-manager/contract_freeze_test.go diffs this file against those types on every run, so drift fails the build rather than surviving as an out-of-date artefact. Any field addition needs a MINOR bump (v1alpha2) and any rename, removal or retype needs a MAJOR bump (v1), both approved by the P1-GOV governor.",
  "x-schema-version": "sler.signalloom.io/v1alpha1",
  "x-frozen-by": "SLER-P1-3",
  "x-signature-encoding": "base64(std,padded) of raw 64-byte ed25519 signature",
  "x-resume-token-signing-domain": "sler.signalloom.io/resume-token/v1alpha1",
  "$defs": {
    "PlaneOutcome": {
      "description": "Tri-state-plus outcome of one enforcement action. 'unavailable' means the plane did not answer and the target's state is UNKNOWN; 'not_found' means the plane answered and there was nothing to contain. They are deliberately distinct: the first sends an operator to check plane connectivity, the second sends them to check their targeting.",
      "type": "string",
      "enum": [
        "contained",
        "partial",
        "unavailable",
        "not_found"
      ]
    },
    "EnforcementPlane": {
      "description": "The five enforcement planes a containment decision fans out to. Frozen complete: mesh (network isolation), bao (OpenBao lease revocation), spire (SVID entry eviction), admission (readmission block), freeze (cgroup v2 process freeze).",
      "type": "string",
      "enum": [
        "mesh",
        "bao",
        "spire",
        "admission",
        "freeze"
      ]
    },
    "PlaneResult": {
      "description": "Per-plane containment result. Carries its own outcome and error so a partial containment is representable.",
      "type": "object",
      "properties": {
        "plane": {
          "$ref": "#/$defs/EnforcementPlane"
        },
        "outcome": {
          "$ref": "#/$defs/PlaneOutcome"
        },
        "error": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "latency_ms": {
          "type": "integer"
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "plane",
        "outcome",
        "timestamp"
      ],
      "additionalProperties": false
    },
    "TargetRef": {
      "description": "Identifies the workload being contained.",
      "type": "object",
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "pod_name": {
          "type": "string"
        },
        "spiffe_id": {
          "type": "string"
        },
        "node_name": {
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "namespace"
      ],
      "additionalProperties": false
    },
    "ContainmentReason": {
