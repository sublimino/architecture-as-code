    "no-privileged-containers": "fail",
    "no-host-pid": "fail",
    "no-host-ipc": "fail",
    "no-host-network": "fail",
    "no-privilege-escalation": "fail",
    "no-root-containers": "fail",
    "no-net-raw": "fail",
    "no-added-capabilities": "fail",
    "capabilities-dropped-all": "fail",
    "no-windows-hostprocess": "fail",
    "no-hostpath-volumes": "fail",
    "no-host-ports": "fail",
    "no-secrets-in-env": "fail",
    "seccomp-runtime-default": "fail",
    "security-context-applied": "fail",
    "no-default-namespace": "pass"
  }
}
