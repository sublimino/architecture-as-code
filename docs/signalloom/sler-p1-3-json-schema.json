    "ResumeTokenSignature": {
      "description": "One operator's Ed25519 signature. The signature covers the token body AND this entry's own operator_id, key_id, alg and signed_at, so a signature cannot be transplanted onto a different signer's entry.",
      "type": "object",
      "properties": {
        "operator_id": {
          "description": "Signer identity, normatively a SPIFFE ID. The verifier MUST confirm the registry agrees this key belongs to this operator.",
          "type": "string"
        },
        "key_id": {
          "description": "Self-certifying handle \"sha256:<lowercase hex of SHA-256 over the raw 32-byte public key>\". The verifier MUST recompute it.",
          "type": "string"
        },
        "alg": {
          "description": "MUST be \"ed25519\".",
          "type": "string"
        },
        "signed_at": {
          "description": "RFC3339 UTC. Covered by this signature.",
          "type": "string"
        },
        "signature": {
          "description": "Raw 64-byte Ed25519 signature (RFC 8032 R||S), base64 std-encoded with padding: exactly 88 characters. Not hex, not base64url, not DER.",
          "type": "string"
        }
      },
      "required": [
        "operator_id",
        "key_id",
        "alg",
        "signed_at",
        "signature"
      ],
      "additionalProperties": false
    },
    "ResumeToken": {
      "description": "Attributable governance token required to reverse a stun. Replaces the shared-secret bearer credential (STUN_RESUME_TOKEN), which is structurally incapable of attribution because every operator presents identical bytes.",
      "type": "object",
      "properties": {
        "schema_version": {
          "description": "MUST be \"sler.signalloom.io/v1alpha1\". A detached token must still be checkable.",
          "type": "string"
        },
        "token_id": {
          "description": "Unique token identity. The verifier MUST enforce single use on this value.",
          "type": "string"
        },
        "alg": {
          "description": "MUST be \"ed25519\". Carried so an unknown algorithm is rejected rather than assumed.",
          "type": "string"
        },
        "agent_id": {
          "description": "Target agent. Bound by the signature.",
          "type": "string"
        },
        "namespace": {
          "description": "Target namespace. Not optional: without it a staging token resumes a production agent of the same name.",
          "type": "string"
        },
        "audience": {
          "description": "The cluster or sentinel fleet this token is valid at.",
          "type": "string"
        },
        "operator_id": {
          "description": "First signer's identity, normatively a SPIFFE ID. MUST equal signatures[0].operator_id.",
          "type": "string"
        },
        "governance_approval_ref": {
          "description": "Reference to the governance approval this resume is executing.",
          "type": "string"
        },
        "issued_at": {
          "description": "RFC3339 UTC. Covered by the signature.",
          "type": "string"
        },
        "expires_at": {
          "description": "RFC3339 UTC. Covered by the signature. The verifier caps expires_at - issued_at by policy.",
          "type": "string"
        },
        "nonce": {
          "description": "base64(std) and MUST decode to at least 16 bytes of entropy.",
          "type": "string"
        },
        "trust_root_id": {
          "description": "Names the operator-key trust root the minter expects the verifier to pin. The verifier MUST reject a token naming a different root. Closes silent registry substitution under a different root; does NOT close an adversary who can write the pinned registry — see frozen-contract section 7.",
          "type": "string"
        },
        "required_signatures": {
          "description": "The approval threshold recorded at mint time. The verifier enforces max(its own policy, this value) — the token may RAISE the bar, never lower it. Without it, stripping one signature from a genuine dual-approval token yields something indistinguishable from a legitimate single-operator resume.",
          "type": "integer"
        },
        "signature": {
          "description": "First signer's signature. MUST equal signatures[0].signature.",
          "type": "string"
        },
        "signatures": {
          "description": "Every signer. A dual-control policy requires at least two entries with DISTINCT operator_id AND DISTINCT key_id — counting signatures rather than distinct operators is satisfied by one operator holding two keys.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResumeTokenSignature"
          }
        }
      },
      "required": [
        "schema_version",
        "token_id",
        "alg",
        "agent_id",
        "namespace",
        "audience",
        "operator_id",
        "governance_approval_ref",
        "issued_at",
        "expires_at",
        "nonce",
        "trust_root_id",
        "required_signatures",
        "signature",
        "signatures"
      ],
      "additionalProperties": false
    },
