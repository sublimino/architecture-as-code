# Copy this file to .env and fill in your ServiceNow PDI details. The .env
# file is gitignored, so the credentials stay on your machine.
#
# scripts/olly-pdi-secret.sh reads these and creates the `servicenow-pdi`
# secret in the olly-replica namespace; the io-mapping-service stub picks it
# up and writes enrichment work notes to your PDI instead of its in-memory
# ticket store. `make up` runs that script at the end, so a filled-in .env
# is all it takes.
#
# Quote any value containing spaces or shell metacharacters, e.g. PASSWORD='p@$$ w0rd'.

SERVICENOW_URL=https://devXXXXXX.service-now.com
SERVICENOW_USER=admin
SERVICENOW_PASSWORD=change-me

# Olly Sentinel LLM narrator. The pipeline is deterministic; the model only
# writes the RCA narrative (it never decides). scripts/olly-llm-secret.sh reads
# these into the `olly-llm` secret and the sentinel picks them up. Leave
# LLM_PROVIDER blank to keep the deterministic RCA.
#   LLM_PROVIDER: openrouter | anthropic | openai | ollama
#   LLM_MODEL:    provider model id, e.g. anthropic/claude-3.5-haiku (openrouter),
#                 claude-3-5-haiku-latest (anthropic), gpt-4o-mini (openai),
#                 llama3.2 (ollama). Blank uses a sensible per-provider default.
#   LLM_API_KEY:  required for openrouter/anthropic/openai; unused for ollama.
#   LLM_URL:      ollama / custom OpenAI-compatible base, e.g. http://host.docker.internal:11434
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_URL=

# Security Sandbox: the LLM Guard scanner (in-cluster pod on the Olly -> Orbit
# A2A hop) and the promptfoo red-team UI. One knob for both. Leave false unless
# the node has RAM headroom: the LLM Guard pod loads ~2-3GB of scanner models,
# and the full estate already fills a 10GB kind node.
#   false -> guard pod scaled to 0, sentinel hop off, promptfoo stopped (default).
#   true  -> guard pod scaled to 1, sentinel LLM_GUARD_ENABLED=true, promptfoo up.
# `make security-sandbox` applies whatever this is set to; `make up` respects it.
# The promptfoo red-team also needs a provider key in
# olly-replica/apps/security-sandbox/.env to generate and grade attacks.
SECURITY_SANDBOX_ENABLED=false
