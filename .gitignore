# Local signing material: the cosign key pair never leaves this machine
.keys/

# Build output
tools/demo-console/demo-console
tools/demo-console/demo-console.exe
vex/out/

# Vendored scanner binaries (installed by scripts/setup.sh, not committed)
grype.zip
grypebin/

# Local secrets: ServiceNow PDI credentials and anything else per-machine.
# scripts/olly-pdi-secret.sh reads these to create the in-cluster secret;
# the values never get committed. Copy .env.example to .env to fill in.
.env
.env.local

# Google ADK local dev artefacts: the eval venv and the generated run history
# (eval_history/*.evalset_result.json + session.db) the web UI / adk eval write
# under the agent folder. Kept out of the repo; the GUI's Eval Lab summarizes
# them at runtime rather than committing them.
olly-replica/apps/sentinel/.venv/
olly-replica/apps/sentinel/olly_sentinel/.adk/
demo/*/.venv/
demo/**/.adk/session.db

# Estate 95 console: scoped read-only kubeconfig (holds a cluster token)
.estate95/

# In-cluster zot registry cache mirrored to the host during push-local.
# Files under .cache/zot/ are written by the zot container as UID 65532 and
# are unreadable by git (status chokes on .cache/zot/acme/). Local-only.
.cache/

# Python bytecode
__pycache__/
*.py[cod]

# .DS_Store
.DS_Store

# Playwright storage-state / auth artifacts (session material — never commit)
test/acceptance/.auth/

# wait.sh is a vendored source lib, not a build artifact — override the global `lib` ignore
!scripts/lib/
!scripts/lib/**

# Same override, same reason: ~/.gitignore_global carries a bare `lib` pattern
# (a Python packaging leftover) which silently swallows ANY directory named lib
# at any depth. test/lib/fake-image-cli.bash is the shared docker/crictl model
# for the three suites that exercise scripts/lib/image-identity.sh — without
# this negation it is never committed, and those suites pass locally and then
# fail in CI with "FAKE_IMAGE_CLI: No such file or directory".
!test/lib/
!test/lib/**


# riskctl build output (regenerate with `make riskctl`)
tools/riskctl/riskctl

# Public tunnel state (make public / make public-down)
.tunnel/
tunnel-policy.yaml

# Session artifacts (PAI work memory, plans, CI reports, test results)
MEMORY/
Plans/
ci-reports*/
d2-signalloom/results.tap
test/gcp-results/
test/gcp-5x-results.md
# supercred-e2e.sh writes one .state snapshot and .log per assertion point here
# (31 files for a 5-iteration run), and Playwright drops traces here too. The
# block above claimed to cover "test results" and did not.
test-results/
test/local-5x-results.md
# >>> terraform (F1-foundation) >>>
# Terraform lock files are deliberately committed so everyone resolves the same provider build.
*.tfstate
*.tfstate.*
.terraform/
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
!*.example.tfvars
