{
  "_comment": "Image and tool to upstream mapping for sl-upgrade-scan. github: owner/repo whose non-prerelease GitHub releases are the upstream. eol: endoflife.date product slug. tagPrefix: release tags carry this prefix (kustomize/, jq-). latestFrom: eol means the newest endoflife.date cycle is the latest. registry: false stops the registry tag lookup. An image not listed here is still looked up by its own registry tags; a tool not listed here is reported as unknown.",
  "images": {
    "quay.io/openbao/openbao": { "github": "openbao/openbao" },
    "docker.io/openbao/openbao": { "github": "openbao/openbao" },
    "ghcr.io/spiffe/spire-server": { "github": "spiffe/spire" },
    "ghcr.io/spiffe/spire-agent": { "github": "spiffe/spire" },
    "ghcr.io/spiffe/oidc-discovery-provider": { "github": "spiffe/spire" },
    "ghcr.io/spiffe/spiffe-csi-driver": { "github": "spiffe/spiffe-csi" },
    "ghcr.io/dexidp/dex": { "github": "dexidp/dex" },
    "ghcr.io/stefanprodan/podinfo": { "github": "stefanprodan/podinfo" },
    "ghcr.io/project-zot/zot-linux-amd64": { "github": "project-zot/zot" },
    "registry.k8s.io/coredns/coredns": { "github": "coredns/coredns" },
    "registry.k8s.io/sig-storage/csi-node-driver-registrar": { "github": "kubernetes-csi/node-driver-registrar" },
    "quay.io/jetstack/charts/cert-manager": { "github": "cert-manager/cert-manager" },
    "docker.io/envoyproxy/gateway-helm": { "github": "envoyproxy/gateway" },
    "docker.io/kindest/node": { "eol": "kubernetes" },
    "docker.io/bitnamilegacy/kubectl": { "eol": "kubernetes", "note": "bitnamilegacy is the frozen Bitnami catalogue: it gets no new tags or fixes" },
    "docker.io/library/golang": { "eol": "go" },
    "docker.io/library/python": { "eol": "python" },
    "docker.io/library/node": { "eol": "nodejs" },
    "docker.io/library/postgres": { "eol": "postgresql" },
    "docker.io/library/redis": { "eol": "redis" },
    "docker.io/library/alpine": { "eol": "alpine-linux" },
    "docker.io/library/nginx": { "eol": "nginx" },
    "docker.io/nginxinc/nginx-unprivileged": { "eol": "nginx" },
    "mcr.microsoft.com/devcontainers/go": { "eol": "go" }
  },
  "tools": {
    "kind": { "github": "kubernetes-sigs/kind" },
    "kubectl": { "github": "kubernetes/kubernetes", "eol": "kubernetes" },
    "flux": { "github": "fluxcd/flux2" },
    "helm": { "github": "helm/helm" },
    "cosign": { "github": "sigstore/cosign" },
    "syft": { "github": "anchore/syft" },
    "grype": { "github": "anchore/grype" },
    "trivy": { "github": "aquasecurity/trivy" },
    "kustomize": { "github": "kubernetes-sigs/kustomize", "tagPrefix": "kustomize/" },
    "go": { "eol": "go", "latestFrom": "eol" },
    "node": { "eol": "nodejs", "latestFrom": "eol" },
    "govulncheck": { "goproxy": "golang.org/x/vuln" },
    "vexctl": { "github": "openvex/vexctl" },
    "witness": { "github": "in-toto/witness" },
    "bats": { "github": "bats-core/bats-core" },
    "jq": { "github": "jqlang/jq", "tagPrefix": "jq-" },
    "knative": { "github": "knative/serving", "tagPrefix": "knative-" },
    "crane": { "github": "google/go-containerregistry" },
    "bun": { "github": "oven-sh/bun", "tagPrefix": "bun-" },
    "terraform": { "github": "hashicorp/terraform" },
    "tflint": { "github": "terraform-linters/tflint" },
    "uv": { "github": "astral-sh/uv" },
    "yq": { "github": "mikefarah/yq" },
    "oras": { "github": "oras-project/oras" },
    "kubeconform": { "github": "yannh/kubeconform" },
    "conftest": { "github": "open-policy-agent/conftest" },
    "opa": { "github": "open-policy-agent/opa" },
    "shellcheck": { "github": "koalaman/shellcheck" },
    "gitleaks": { "github": "gitleaks/gitleaks" },
    "semgrep": { "pypi": "semgrep" },
    "stern": { "github": "stern/stern" },
    "k9s": { "github": "derailed/k9s" },
    "zot": { "github": "project-zot/zot" },
    "golangci-lint": { "github": "golangci/golangci-lint" }
  }
}
