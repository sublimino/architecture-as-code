    "evidence_page":{"type":"object","additionalProperties":false,"required":["schema_version","tenant_id","items","next_cursor"],"properties":{"schema_version":{"const":"1.0.0"},"tenant_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,63}$"},"items":{"type":"array","maxItems":500,"items":{"$ref":"#/$defs/evidence_item"}},"next_cursor":{"type":["string","null"],"maxLength":256}}},
