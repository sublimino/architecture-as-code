{
  "name": "baseline-windows-compliant",
  "level": "unit",
  "description": "Compliant Windows baseline (spec.os.name windows): Linux-only checks are exempt, all checks pass.",
  "input": {
    "object": {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "baseline-windows-compliant",
        "namespace": "win-apps"
      },
      "spec": {
        "os": {
          "name": "windows"
        },
        "automountServiceAccountToken": false,
        "securityContext": {
          "runAsNonRoot": true,
          "windowsOptions": {
            "runAsUserName": "ContainerUser"
          }
        },
        "containers": [
          {
            "name": "iis",
            "image": "mcr.microsoft.com/windows/servercore/iis:windowsservercore-ltsc2022",
            "securityContext": {
              "windowsOptions": {
                "runAsUserName": "ContainerUser"
              }
            }
          }
        ]
      }
    },
    "agent": {},
    "request": {}
  },
  "expect": {
    "sa-token-automount-disabled": "pass",
    "no-privileged-containers": "pass",
    "no-host-pid": "pass",
    "no-host-ipc": "pass",
    "no-host-network": "pass",
    "no-privilege-escalation": "pass",
    "no-root-containers": "pass",
    "no-net-raw": "pass",
    "no-added-capabilities": "pass",
    "capabilities-dropped-all": "pass",
    "no-windows-hostprocess": "pass",
    "no-hostpath-volumes": "pass",
    "no-host-ports": "pass",
    "no-secrets-in-env": "pass",
    "seccomp-runtime-default": "pass",
    "security-context-applied": "pass",
    "no-default-namespace": "pass"
  }
}
