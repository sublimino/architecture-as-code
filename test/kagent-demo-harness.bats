#!/usr/bin/env bats
# test/kagent-demo-harness.bats — Demo 5 lifecycle scripts and the proof artefact.
#
# WHAT WAS WRONG HERE
# -------------------
# All three tests in this file were vacuous, and two of them in a way that made
# the repo actively misleading:
#
#   * "full lifecycle dry-run passes" ran `kagent-infra.sh status` and
#     `kagent-agents.sh status` and asserted exit 0. Both scripts exit 0 when
#     the namespace does not exist ("Namespace 'kagent' does not exist"), and
#     kagent-agents.sh additionally ends its kubectl call with `|| true`. The
#     test therefore passed against an empty cluster.
#
#   * The two "proof file" tests asserted properties of
#     .kagent-preflight-proof.json — a file that is COMMITTED TO GIT. They were
#     reading a stale artefact from a previous run: it recorded git_commit
#     ef483f3e, four pod names that no longer exist, and five Agent CRs when
#     eight are deployed. `.agent_crs | length >= 5` is satisfied by that stale
#     list forever, whatever the cluster is doing. A proof gate that passes
#     without the cluster being consulted is not a gate.
#
# The proof file is regenerated by scripts/kagent-harness-exec.sh. These tests
# now assert that what is on disk describes THIS commit and THIS cluster, so a
# stale artefact fails instead of vouching for itself.

setup() {
  REPO_ROOT="$(cd "$BATS_TEST_DIRNAME/.." && pwd)"
  KUBECONFIG_PATH="${KUBECONFIG:-${REPO_ROOT}/.kind/kubeconfig}"
  if [ -f "${KUBECONFIG_PATH}" ]; then
    export KUBECONFIG="${KUBECONFIG_PATH}"
  fi
  PROOF_FILE="${REPO_ROOT}/.kagent-preflight-proof.json"
}

stage_harness() {
  HARNESS_ROOT="${BATS_TEST_TMPDIR}/harness-repo"
  mkdir -p "${HARNESS_ROOT}/scripts"
  cp "${REPO_ROOT}/scripts/kagent-harness-exec.sh" "${HARNESS_ROOT}/scripts/"
  cat >"${HARNESS_ROOT}/scripts/kagent-test.sh" <<'EOF'
#!/usr/bin/env bash
echo 'KAGENT_TALLY passed=1 failed=0 skipped=0'
EOF
  chmod +x "${HARNESS_ROOT}/scripts/kagent-test.sh"
}

@test "kagent-demo: harness preserves hostile task IDs as JSON data" {
  stage_harness
  marker="${BATS_TEST_TMPDIR}/task-id-injected"
  task_id=$'quoted "task"\nline'
  task_id+=", 'injected': __import__('pathlib').Path('"
  task_id+="$marker"
  task_id+="').touch(), 'task_id': 'rewritten"

  run "${HARNESS_ROOT}/scripts/kagent-harness-exec.sh" "$task_id"
  [ "$status" -eq 0 ] || { echo "$output"; return 1; }
  [ ! -e "$marker" ] || {
    echo "TASK_ID executed as generated Python source"
    return 1
  }

  proof="${HARNESS_ROOT}/.kagent-preflight-proof.json"
  run python3 - "$proof" "$task_id" <<'PY'
import json
import sys

with open(sys.argv[1]) as handle:
    proof = json.load(handle)
assert proof["task_id"] == sys.argv[2]
PY
  [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "kagent-demo: harness records ordinary task IDs" {
  stage_harness

  run "${HARNESS_ROOT}/scripts/kagent-harness-exec.sh" P0
  [ "$status" -eq 0 ] || { echo "$output"; return 1; }

  run jq -r '.task_id' "${HARNESS_ROOT}/.kagent-preflight-proof.json"
  [ "$status" -eq 0 ]
  [ "$output" = "P0" ]
}

@test "kagent-demo: infra status reports the live control-plane pods" {
  run bash "${REPO_ROOT}/scripts/kagent-infra.sh" status
  [ "$status" -eq 0 ]

  # Exit 0 is not the signal: the script exits 0 on the "namespace does not
  # exist" branch too. Assert the output names the pods the cluster is running.
  live_pods="$(kubectl get pods -n kagent --no-headers -o custom-columns=':metadata.name' 2>/dev/null || true)"
  [ -n "$live_pods" ] || {
    echo "no pods in namespace kagent — nothing for the status output to report"
    return 1
  }

  unreported=""
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    case "$output" in
      *"$p"*) ;;
      *) unreported+="$p " ;;
    esac
  done <<<"$live_pods"

  if [ -n "$unreported" ]; then
    echo "kagent-infra.sh status did not report these running pods: $unreported"
    echo "--- status output ---"
    echo "$output"
  fi
  [ -z "$unreported" ]
}

@test "kagent-demo: agents status reports every Agent CR" {
  run bash "${REPO_ROOT}/scripts/kagent-agents.sh" status
  [ "$status" -eq 0 ]

  live_agents="$(kubectl get agents -n fe-signalloom-agents --no-headers -o custom-columns=':metadata.name' 2>/dev/null || true)"
  [ -n "$live_agents" ] || {
    echo "no Agent CRs in fe-signalloom-agents — nothing for the status output to report"
    return 1
  }

  unreported=""
  while IFS= read -r a; do
    [ -n "$a" ] || continue
    case "$output" in
      *"$a"*) ;;
      *) unreported+="$a " ;;
    esac
  done <<<"$live_agents"

  if [ -n "$unreported" ]; then
    echo "kagent-agents.sh status did not report these Agent CRs: $unreported"
    echo "--- status output ---"
    echo "$output"
  fi
  [ -z "$unreported" ]
}

@test "kagent-demo: proof artefact describes the current commit" {
  [ -f "$PROOF_FILE" ] || {
    echo "no proof artefact at $PROOF_FILE — run scripts/kagent-harness-exec.sh"
    return 1
  }

  # FAILED belongs in this list. The inherited version accepted only STARTED or
  # COMPLETED, so an artefact honestly recording a failed run was rejected as
  # malformed while a stale COMPLETED one from an older commit sailed through —
  # pressure, however unintentional, to leave the flattering artefact in place.
  run jq -e '(.status == "STARTED" or .status == "COMPLETED" or .status == "FAILED") and .git_commit != null' "$PROOF_FILE"
  [ "$status" -eq 0 ] || {
    echo "proof artefact has no usable status/git_commit:"
    jq -c '{status, git_commit, test_status}' "$PROOF_FILE"
    return 1
  }

  # FRESHNESS, expressed as "does this evidence still apply", not as
  # "was it generated at HEAD".
  #
  # Requiring proof_sha == HEAD is unachievable for a git-tracked artefact:
  # regenerating it produces a change, committing that change moves HEAD, and
  # the artefact is stale again the instant it lands. An assertion no correct
  # workflow can satisfy gets suppressed rather than fixed.
  #
  # The property that actually matters is that nothing the evidence describes
  # has changed since it was taken. Diff the recorded commit against the
  # WORKING TREE (not HEAD) over the kagent surface, so uncommitted edits
  # invalidate it too.
  proof_sha="$(jq -r '.git_commit' "$PROOF_FILE")"
  git -C "$REPO_ROOT" rev-parse --verify --quiet "${proof_sha}^{commit}" >/dev/null || {
    echo "proof artefact names commit '$proof_sha', which is not in this repository"
    echo "regenerate with: scripts/kagent-harness-exec.sh"
    return 1
  }

  changed="$(git -C "$REPO_ROOT" diff --name-only "$proof_sha" -- \
    'd2-signalloom/infra/kagent' \
    'd2-signalloom/infra/agent-swarm' \
    'd2-signalloom/test/kagent-contract.bats' \
    'test/kagent-*.bats' \
    'scripts/kagent-*.sh' \
    'docs/kagent-d5.md' 2>/dev/null || true)"

  if [ -n "$changed" ]; then
    echo "the proof artefact was generated at '$proof_sha'; these kagent files"
    echo "have changed since, so it is evidence about a different tree:"
    printf '  %s\n' $changed
    echo "regenerate with: scripts/kagent-harness-exec.sh"
  fi
  [ -z "$changed" ]
}

@test "kagent-demo: proof artefact lists exactly the Agent CRs the cluster has" {
  [ -f "$PROOF_FILE" ] || {
    echo "no proof artefact at $PROOF_FILE — run scripts/kagent-harness-exec.sh"
    return 1
  }

  # Was `.agent_crs | length >= 5` against a hardcoded list of five. Compare the
  # recorded set to the live set, so neither drift nor a stale file can pass.
  proof_set="$(jq -r '.agent_crs[]' "$PROOF_FILE" | sort | paste -sd, -)"
  live_set="$(kubectl get agents -n fe-signalloom-agents --no-headers -o custom-columns=':metadata.name' 2>/dev/null | sort | paste -sd, -)"

  [ -n "$live_set" ] || {
    echo "no Agent CRs in the cluster to compare against"
    return 1
  }
  [ "$proof_set" = "$live_set" ] || {
    echo "the proof artefact does not describe this cluster"
    echo "  proof: $proof_set"
    echo "  live : $live_set"
    echo "regenerate with: scripts/kagent-harness-exec.sh"
    return 1
  }
}

@test "kagent-demo: proof artefact's assertion count matches the suites it ran" {
  [ -f "$PROOF_FILE" ] || {
    echo "no proof artefact at $PROOF_FILE — run scripts/kagent-harness-exec.sh"
    return 1
  }

  # scripts/kagent-harness-exec.sh wrote `'test_assertions_passed': 23` as a
  # literal, independent of what the suites did. 23 was never the number of
  # tests in this repo. A fabricated figure inside an artefact named "proof" is
  # the worst kind of vacuity: it is quoted downstream as a measurement.
  # ─── The artefact is always complete; no mid-generation state exists ─────
  #
  # This test used to fail on every harness run: kagent-harness-exec.sh wrote
  # git_commit up front and the counts only after the suites finished, so the
  # artefact it inspected had no count yet and jq returned the -1 default.
  # I worked around it with a skip. kagent-tests-docs fixed it properly instead
  # — the harness now writes a .inprogress sidecar and os.replace()s the
  # published file only once the counts are known, so a reader always sees a
  # COMPLETE artefact (during a run, the previous one: a true statement about a
  # real earlier run rather than a half-written one about this run).
  #
  # The skip is therefore deleted rather than kept as belt-and-braces, for
  # their reason: A SKIP IS INDISTINGUISHABLE FROM A PASS IN A SUMMARY LINE.
  # An unreachable skip would leave the exact shape this work removed.
  #
  # The two malformed-artefact checks below are KEPT. Under atomic publish
  # those shapes can only occur if the artefact is genuinely malformed, which
  # is precisely when they should fail.
  if [ "$(jq -r 'has("test_assertions_passed")' "$PROOF_FILE")" != "true" ]; then
    jq -e 'has("git_commit")' "$PROOF_FILE" >/dev/null || {
      echo "artefact has neither a git_commit nor an assertion count; it is malformed"
      return 1
    }
    echo "artefact has a git_commit but no assertion count. With atomic publish"
    echo "that state is unreachable, so this artefact was not written by"
    echo "scripts/kagent-harness-exec.sh"
    return 1
  fi

  claimed="$(jq -r '.test_assertions_passed // -1' "$PROOF_FILE")"

  # ─── The suite list is PARSED OUT OF THE RUNNER, not hand-copied ─────────
  #
  # It was a copy and it drifted: the runner grew test/kagent-infra.bats and
  # the copy did not, so the ceiling read 52 while the runner genuinely passed
  # 64 and this test called the artefact implausible. The artefact was right
  # and the guard was wrong — the worse direction, because the natural response
  # is to distrust the measurement, and the measurement was the honest party.
  #
  # Parsed rather than sourced: kagent-test.sh RUNS the suites on execution, so
  # sourcing it from inside a test of itself would recurse.
  runner="${REPO_ROOT}/scripts/kagent-test.sh"
  [ -f "$runner" ] || { echo "runner not found at $runner"; return 1; }
  mapfile -t suites < <(sed -n '/^SUITES=(/,/^)/p' "$runner" |
    sed -n 's|.*"\${REPO_ROOT}/\([^"]*\)".*|\1|p')

  # A silent parse failure would leave the ceiling at zero and make every claim
  # look plausible, so the parse itself is asserted before anything rests on it.
  [ "${#suites[@]}" -gt 0 ] || {
    echo "could not parse the SUITES array from ${runner}"
    echo "the ceiling would be zero and every claimed count would pass"
    return 1
  }

  actual=0
  for rel in "${suites[@]}"; do
    suite="${REPO_ROOT}/${rel}"
    [ -f "$suite" ] || continue
    n="$(grep -c '^@test ' "$suite" || true)"
    actual=$((actual + n))
  done

  # The parse is already asserted above via ${#suites[@]}; a second check on a
  # `counted` variable survived the merge as a leftover from the other side's
  # while-loop form and referenced a name nothing sets any more.
  [ "$actual" -gt 0 ]

  # Equality is only meaningful for a run that passed. On a failing run the
  # harness legitimately records fewer, and cascading a second failure out of
  # that would just be noise; assert the count is at least plausible instead.
  # Skips count toward the ceiling but never toward passes, so a PASS run
  # satisfies passed + skipped == total. Asserting passed == total instead
  # would fail on any legitimate skip and invite someone to "fix" it by folding
  # skips back into the pass count — which is the conflation being removed.
  skipped="$(jq -r '.test_assertions_skipped // 0' "$PROOF_FILE")"
  accounted=$((claimed + skipped))

  test_status="$(jq -r '.test_status // "UNKNOWN"' "$PROOF_FILE")"
  if [ "$test_status" = "PASS" ]; then
    [ "$accounted" = "$actual" ] || {
      echo "artefact accounts for ${accounted} of ${actual} tests"
      echo "  passed:  ${claimed}"
      echo "  skipped: ${skipped}"
      echo "proof artefact claims ${claimed} assertions passed on a PASS run;"
      echo "the suites it ran contain ${actual} tests"
      echo "regenerate with: scripts/kagent-harness-exec.sh"
      return 1
    }
  else
    [ "${claimed:-0}" -ge 0 ] && [ "${claimed:-0}" -le "$actual" ] || {
      echo "proof artefact claims ${claimed} passes out of at most ${actual} tests"
      return 1
    }
  fi
}
