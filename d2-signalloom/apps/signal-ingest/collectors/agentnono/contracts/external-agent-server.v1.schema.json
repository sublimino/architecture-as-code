    "acceptance":{"type":"object","additionalProperties":false,"required":["schema_version","upload_id","accepted_at","replay_result","host_signature_state","original_chain_state"],"properties":{"schema_version":{"const":"1.0.0"},"upload_id":{"type":"string","pattern":"^[A-Za-z0-9-]{16,128}$"},"accepted_at":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"},"replay_result":{"enum":["accepted","idempotent-replay"]},"host_signature_state":{"const":"host-signature-verified"},"original_chain_state":{"const":"original-chain-not-verified"}}},
