{
  "title": "Tenant App View (Olly replica)",
  "uid": "tenant-app-view",
  "tags": [
    "olly-replica",
    "tenant",
    "per-app"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Open incidents in ServiceNow",
      "type": "link",
      "icon": "external link",
      "url": "${snow_url}/incident_list.do",
      "targetBlank": true,
      "tooltip": "Browse the Olly-tracked incidents in the ServiceNow PDI"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Tenant app",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "olly-prom"
        },
        "query": {
          "query": "label_values(tenant_app_up, app_id)",
          "refId": "a"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "inventory-service",
          "value": "inventory-service"
        }
      },
      {
        "name": "snow_url",
        "label": "ServiceNow base URL",
        "description": "Your PDI base URL; match SERVICENOW_URL in .env.",
        "type": "constant",
        "query": "https://dev379184.service-now.com",
        "current": {
          "text": "https://dev379184.service-now.com",
          "value": "https://dev379184.service-now.com"
        },
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Health: $app (live application metrics)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Request rate",
      "description": "req/s served by $app (tenant-app /metrics).",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "olly-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(tenant_app_requests_total{app_id=\"$app\"}[5m]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "NO DATA",
          "unit": "reqps",
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error rate",
      "description": "5xx as a percentage of all requests for $app.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "olly-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(tenant_app_requests_total{app_id=\"$app\",code=\"500\"}[5m])) / clamp_min(sum(rate(tenant_app_requests_total{app_id=\"$app\"}[5m])), 0.001)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "NO DATA",
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latency p95",
      "description": "95th percentile request latency for $app.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "olly-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tenant_app_request_duration_seconds_bucket{app_id=\"$app\"}[5m])))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "NO DATA",
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.2
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Serving",
      "description": "tenant_app_up: 1 when $app is serving. NO DATA renders explicitly, never green.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "olly-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(tenant_app_up{app_id=\"$app\"})",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "NO DATA",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green"
                },
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate by response code",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "olly-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(tenant_app_requests_total{app_id=\"$app\"}[1m]))",
          "legendFormat": "{{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "NO DATA",
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "olly-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(tenant_app_request_duration_seconds_bucket{app_id=\"$app\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tenant_app_request_duration_seconds_bucket{app_id=\"$app\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(tenant_app_request_duration_seconds_bucket{app_id=\"$app\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "NO DATA",
          "unit": "s",
          "custom": {
            "drawStyle": "line"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Pod CPU (cores)",
      "description": "Real container CPU for $app from cAdvisor: genuine pod metrics now that the tenant app is a real workload.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "olly-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"olly-replica\", pod=~\"$app-.*\", container=\"app\"}[5m]))",
          "legendFormat": "cpu cores"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "NO DATA",
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Pod memory (working set)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "olly-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(container_memory_working_set_bytes{namespace=\"olly-replica\", pod=~\"$app-.*\", container=\"app\"})",
          "legendFormat": "working set"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "NO DATA",
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 200,
      "type": "row",
      "title": "Security: Aqua / Trivy ($app)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Image vulnerabilities by severity",
      "description": "Provenance: trivy-operator VulnerabilityReports for $app's workload, exported as Prometheus metrics. Scoped read-only Aqua feed.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "olly-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (severity) (trivy_image_vulnerabilities{exported_namespace=\"olly-replica\", resource_name=~\"$app.*\"})",
          "legendFormat": "{{severity}}",
          "instant": true
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "NO DATA",
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Vulnerabilities by image and severity ($app)",
      "description": "Affected runtime images for this tenant and their vulnerability counts by severity (Trivy Operator). For CVE-level detail, use the estate dashboard's Aqua drill-down.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "olly-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (image_repository, image_tag, severity) (trivy_image_vulnerabilities{exported_namespace=\"olly-replica\", resource_name=~\"$app.*\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "container": true,
              "endpoint": true,
              "namespace": true,
              "pod": true,
              "service": true
            },
            "renameByName": {
              "image_repository": "image",
              "image_tag": "tag",
              "Value": "count"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "count",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "NO DATA"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Critical": {
                        "color": "red",
                        "index": 0
                      },
                      "High": {
                        "color": "orange",
                        "index": 1
                      },
                      "Medium": {
                        "color": "yellow",
                        "index": 2
                      },
                      "Low": {
                        "color": "blue",
                        "index": 3
                      },
                      "Unknown": {
                        "color": "text",
                        "index": 4
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 400,
      "type": "row",
      "title": "Agent control tower: $app (RCA lifecycle and incidents)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Incident lifecycle throughput ($app)",
      "description": "Agent-emitted Prometheus metrics, sliced to this tenant by the app_id label the sentinel now stamps on every counter.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "olly-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(olly_incidents_received_total{app_id=\"$app\"}[5m]))",
          "legendFormat": "received"
        },
        {
          "refId": "B",
          "expr": "sum(rate(olly_incidents_processed_total{outcome=\"completed\", app_id=\"$app\"}[5m]))",
          "legendFormat": "completed"
        },
        {
          "refId": "C",
          "expr": "sum(rate(olly_incidents_processed_total{outcome=\"failed\", app_id=\"$app\"}[5m]))",
          "legendFormat": "failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "NO DATA",
          "custom": {
            "drawStyle": "line",
            "spanNulls": true,
            "showPoints": "always",
            "pointSize": 6,
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "bargauge",
      "title": "Pipeline stage latency p90 ($app, last 1h)",
      "description": "Per-stage p90 RCA timings for this tenant over the last hour from olly_stage_duration_seconds. A snapshot rather than a timeline, because RCA runs are on-demand and a rate-based line goes gappy between them; the sub-15-minute time-to-RCA target is the sum across these stages.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "olly-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.9, sum by (stage, le) (rate(olly_stage_duration_seconds_bucket{app_id=\"$app\"}[1h])))",
          "legendFormat": "{{stage}}",
          "instant": true
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "NO DATA",
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Incidents ($app)",
      "description": "Individual incidents for this tenant (olly-incidents index, mirrored from the IO Mapping Service). state=enriched means Olly has posted an RCA. Click an INC to open that exact record in ServiceNow. 24h look-back so the startup-seeded incidents stay visible.",
      "timeFrom": "24h",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "olly-es-incidents"
      },
      "targets": [
        {
          "refId": "A",
          "query": "app_id:$app",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "raw_data",
              "settings": {
                "size": "50"
              }
            }
          ],
          "bucketAggs": []
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "@timestamp": true,
              "_id": true,
              "_index": true,
              "_type": true,
              "correlation_id": true,
              "app_id": true,
              "alert_type": true,
              "confidence_score": true,
              "created_at": true,
              "rca_summary": true,
              "highlight": true,
              "sort": true
            },
            "indexByName": {
              "inc_number": 0,
              "state": 1,
              "fault_domain": 2,
              "short_description": 3,
              "enriched_at": 4,
              "sys_id": 5
            },
            "renameByName": {
              "inc_number": "INC",
              "fault_domain": "fault domain",
              "short_description": "summary",
              "enriched_at": "enriched"
            }
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "no incidents yet"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "sys_id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "INC"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open ${__value.text} in ServiceNow",
                    "url": "${snow_url}/incident.do?sys_id=${__data.fields.sys_id}&sysparm_record_target=incident",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "enriched": {
                        "color": "green",
                        "index": 0
                      },
                      "in_progress": {
                        "color": "yellow",
                        "index": 1
                      },
                      "new": {
                        "color": "blue",
                        "index": 2
                      },
                      "auto_remediated": {
                        "color": "orange",
                        "index": 3
                      },
                      "raw": {
                        "text": "raw",
                        "color": "#808080",
                        "index": 4
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Recent errors: app-logs-* ($app)",
      "description": "Error log evidence for $app. Untrusted text: Grafana's default HTML escaping is the sanitisation control (design doc §6 safety suite). Seeded fixture, so a 24h look-back.",
      "timeFrom": "24h",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "olly-es-app"
      },
      "targets": [
        {
          "refId": "A",
          "query": "level:ERROR AND app_id:$app",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "raw_data",
              "settings": {
                "size": "20"
              }
            }
          ],
          "bucketAggs": []
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(?!(@timestamp|app_id|level|message)$).*"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "@timestamp": 0,
              "app_id": 1,
              "level": 2,
              "message": 3
            }
          }
        }
      ]
    },
    {
      "type": "text",
      "title": "",
      "transparent": true,
      "id": 1300,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 49
