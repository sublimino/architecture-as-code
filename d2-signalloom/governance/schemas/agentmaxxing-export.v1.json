{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalloom.controlplane.io/schemas/agentmaxxing-export.v1.json",
  "title": "AgentMaxxingAllowlistedExportV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "sequence",
    "observed_at",
    "source",
    "evidence_type",
    "observation_state",
    "integrity_state",
    "tenant_id",
    "agent_id",
    "host_id",
    "attributes"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "session_id": { "type": "string", "pattern": "^[a-zA-Z0-9-]{3,128}$" },
    "sequence": { "type": "integer", "minimum": 0 },
    "observed_at": { "type": "string", "format": "date-time" },
    "source": { "enum": ["nono-0.73.0", "host-sensor-v1", "signal-ingest"] },
    "evidence_type": { "enum": ["process", "artifact", "network", "collection-limit"] },
    "observation_state": { "enum": ["observed", "denied", "unobserved"] },
    "integrity_state": { "enum": ["integrity-verified", "not-integrity-verified"] },
    "tenant_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "agent_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "host_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "attributes": {}
  },
  "allOf": [
    {
      "if": { "properties": { "evidence_type": { "const": "process" } } },
      "then": { "properties": { "attributes": { "$ref": "#/$defs/process_attributes" } } }
    },
    {
      "if": { "properties": { "evidence_type": { "const": "artifact" } } },
      "then": { "properties": { "attributes": { "$ref": "#/$defs/artifact_attributes" } } }
    },
    {
      "if": { "properties": { "evidence_type": { "const": "network" } } },
      "then": { "properties": { "attributes": { "$ref": "#/$defs/network_attributes" } } }
    },
    {
      "if": { "properties": { "evidence_type": { "const": "collection-limit" } } },
      "then": {
        "properties": {
          "observation_state": { "const": "unobserved" },
          "attributes": { "$ref": "#/$defs/limit_attributes" }
        }
      }
    }
  ],
  "$defs": {
    "process_attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["health_state", "cpu_time_ms", "resident_memory_bytes", "exit_code", "restart_count"],
      "properties": {
        "health_state": { "enum": ["starting", "running", "stopped", "failed", "unknown"] },
        "cpu_time_ms": { "type": "integer", "minimum": 0 },
        "resident_memory_bytes": { "type": "integer", "minimum": 0 },
        "exit_code": { "type": ["integer", "null"] },
        "restart_count": { "type": "integer", "minimum": 0 }
      }
    },
    "artifact_attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "root_id", "sha256", "size_bytes", "mtime_ns"],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$" },
        "root_id": { "enum": ["agent-work", "agent-output"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 16777216 },
        "mtime_ns": { "type": "integer", "minimum": 0 }
      }
    },
    "network_attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination_id", "decision"],
      "properties": {
        "destination_id": { "enum": ["signal-loom-ingest", "agentmaxxing-api"] },
        "decision": { "enum": ["allowed", "denied"] }
      }
    },
    "limit_attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_code", "max_file_size_bytes", "max_files_per_window", "max_bytes_per_window", "window_seconds"],
      "properties": {
        "reason_code": { "enum": ["oversize", "files-rate-exhausted", "bytes-rate-exhausted"] },
        "max_file_size_bytes": { "const": 16777216 },
        "max_files_per_window": { "const": 120 },
        "max_bytes_per_window": { "const": 67108864 },
        "window_seconds": { "const": 60 }
      }
    }
  }
}
