# The paired positive: an operator identity with nothing wrong with it.
#
# Every guard in test/terraform-operator-access.bats must stay SILENT on this
# file. A guard that fires here would fire on the real module too, and would be
# switched off within a week.

locals {
  operator_project_roles = [
    "roles/iap.tunnelResourceAccessor",
    "roles/compute.osAdminLogin",
    "projects/changeme-project/roles/slOperatorInstanceLifecycle",
  ]
}

# A well-formed instance-lifecycle role. Present so the permission guard has a
# LEGITIMATE custom role to stay silent on: a guard that fired on every
# google_project_iam_custom_role block would satisfy the overreaching-custom-role
# mutation check while being useless on the real module.
resource "google_project_iam_custom_role" "instance_lifecycle" {
  project = var.project_id
  role_id = "slOperatorInstanceLifecycle"
  title   = "Signal Loom operator — instance lifecycle"
  stage   = "GA"

  permissions = [
    "compute.instances.suspend",
    "compute.instances.resume",
    "compute.instances.start",
    "compute.zoneOperations.get",
  ]
}

resource "google_service_account" "operator" {
  project    = var.project_id
  account_id = "sl-operator"
}

resource "google_project_iam_member" "operator" {
  for_each = toset(local.operator_project_roles)

  project = var.project_id
  role    = each.value
  member  = "serviceAccount:${local.operator_email}"
}

resource "google_service_account_iam_member" "act_as_runtime" {
  service_account_id = "projects/changeme-project/serviceAccounts/sl-rt-demo-1@changeme-project.iam.gserviceaccount.com"
  role               = "roles/iam.serviceAccountUser"
  member             = "serviceAccount:${local.operator_email}"
}
