        "kind-osramp",
        "zot-registry"
      ]
    },
    {
      "order": 4,
      "claimant": "P2-4",
      "sentinelStart": "# >>> SLSI-P2-4: dual-trust verification wiring <<<",
      "sentinelEnd": "# <<< SLSI-P2-4 >>>",
      "stageFunctionName": "stage_p2_4_trust",
      "responsibility": "Applies static Cosign public key Secret to Flux tenant namespace, patches ResourceSets for signature verification, and establishes admission policy carrier",
      "ownedResources": [
        "secret/cosign-pub",
        "ResourceSet/apps",
        "ResourceSet/infra"
      ]
    },
    {
      "order": 5,
      "claimant": "P3-1",
