#!/usr/bin/env bash
#
# Stub for scripts/lib/dex-origin.sh, used by the driver suites.
#
# The real mechanism EXISTS — this is not a placeholder for something unwritten.
# It stands in for the CLUSTER, so scripts/gcp-tf/demo-up.sh's control flow can
# be driven with no kubectl, no flux and no cloud account.
#
# It therefore has one job beyond answering: encoding the real CLI's contract
# exactly. A stub that encodes a DIFFERENT contract keeps both sides green while
# they disagree, and this repo has now shipped that defect twice:
#
#   1. the driver called `apply <origin>` while the mechanism took
#      `apply <method> <origin>`
#   2. the driver treated a non-empty `current` as "somebody holds it", while
#      the mechanism returns the RESTING ORIGIN from `current` when nobody does
#
# The second one is why `holder` is implemented here, and why `current` prints
# the baseline rather than an empty line at rest. The seam tests in
# test/terraform-demo-driver.bats drive the real mechanism against the real
# driver and are what catches the next one of these.
#
#   apply <method> <origin>   claim it for <method>. Non-zero when another
#                             method already holds Dex. The METHOD is what a
#                             later refusal quotes back, so it is echoed too.
#   current                   the origin in force. The BASELINE at rest, never
#                             empty — matching the real mechanism's fallback.
#   holder                    the method holding it, or an empty line when free.
#   restore                   release the lease and return to the baseline.
#   status                    human-readable.
#
# Knobs:
#   STUB_DEX_LOG        file to append invocations to
#   STUB_DEX_CURRENT    what `current` prints (empty => the baseline)
#   STUB_DEX_HOLDER     what `holder` prints. Defaults to a plausible method
#                       whenever STUB_DEX_CURRENT is set, so a test that says
#                       "somebody else is publishing" does not also have to
#                       remember to name them.
#   STUB_DEX_APPLY_RC   exit code for `apply`

log="${STUB_DEX_LOG:-/dev/null}"
printf '%s\n' "$*" >>"$log"

# Must stay identical to DEX_ORIGIN_BASELINE in scripts/lib/dex-origin.sh.
baseline="${STUB_DEX_BASELINE:-https://dashboard.osramp.acme.local:30754}"

case "${1:-}" in
  current)
    printf '%s\n' "${STUB_DEX_CURRENT:-$baseline}"
    exit 0
    ;;
  holder)
    # Empty line, not nothing, at rest — which is what the caller's
    # `tail -1 | tr -d '[:space:]'` has to cope with. A stub that printed
    # nothing at all would let a caller that mishandles whitespace pass.
    if [ -n "${STUB_DEX_HOLDER:-}" ]; then
      printf '%s\n' "$STUB_DEX_HOLDER"
    elif [ -n "${STUB_DEX_CURRENT:-}" ] && [ "${STUB_DEX_CURRENT}" != "$baseline" ]; then
      printf 'ngrok\n'
    else
      printf '\n'
    fi
    exit 0
    ;;
  apply)
    [ "${STUB_DEX_APPLY_RC:-0}" = "0" ] || {
      printf 'dex-origin: refusing, %s already holds the issuer\n' "${STUB_DEX_CURRENT:-something}" >&2
      exit "${STUB_DEX_APPLY_RC}"
    }
    printf 'dex-origin: issuer now %s (method %s)\n' "${3:-}" "${2:-}"
    exit 0
    ;;
  restore | status)
    exit 0
    ;;
esac

exit 0
