.keys/

# Build output
vex/out/
evidence/out/
docs/records/ci-evidence/local-witness/

# Vendored scanner binaries (installed by scripts/setup.sh, not committed)
grype.zip
grypebin/

# Local secrets and per-machine configuration (never committed).
