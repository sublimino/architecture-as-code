{
  "name": "helm-chart-redis-pod",
  "level": "integration",
  "description": "A Bitnami-Redis-shaped Helm pod: root init container, unpinned docker.io images, a metrics sidecar with defaults, container-level seccomp only, a partially governed agent and a cross-namespace write_file request with an invalid approval.",
  "input": {
    "object": {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "redis-master-0",
        "namespace": "cache",
        "labels": {
          "app": "redis",
          "app.kubernetes.io/name": "redis",
          "app.kubernetes.io/instance": "redis",
          "app.kubernetes.io/managed-by": "Helm",
          "helm.sh/chart": "redis-18.1.0"
        },
        "annotations": {
          "checksum/config": "9f2c1e"
        }
      },
      "spec": {
        "serviceAccountName": "redis",
        "automountServiceAccountToken": false,
        "securityContext": {
          "fsGroup": 1001
        },
        "initContainers": [
          {
            "name": "volume-permissions",
            "image": "docker.io/bitnami/os-shell:12-debian-12-r16",
            "command": [
              "/bin/bash",
              "-ec",
              "chown -R 1001:1001 /data"
            ],
            "securityContext": {
              "runAsUser": 0
            },
            "resources": {},
            "volumeMounts": [
              {
                "name": "redis-data",
                "mountPath": "/data"
              }
            ]
          }
        ],
        "containers": [
          {
            "name": "redis",
            "image": "docker.io/bitnami/redis:7.2.4-debian-12-r9",
            "ports": [
              {
                "name": "redis",
                "containerPort": 6379
              }
            ],
            "securityContext": {
              "runAsUser": 1001,
              "runAsNonRoot": true,
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "128Mi"
              }
            },
            "livenessProbe": {
              "exec": {
                "command": [
                  "sh",
                  "-c",
                  "/health/ping_liveness_local.sh 5"
                ]
              },
              "initialDelaySeconds": 20
            },
            "readinessProbe": {
              "exec": {
                "command": [
                  "sh",
                  "-c",
                  "/health/ping_readiness_local.sh 1"
                ]
              },
              "initialDelaySeconds": 20
            },
            "volumeMounts": [
              {
                "name": "redis-data",
                "mountPath": "/data"
              }
            ]
          },
          {
            "name": "metrics",
            "image": "docker.io/bitnami/redis-exporter:1.55.0",
            "securityContext": {
              "runAsUser": 1001,
              "runAsNonRoot": true
            },
            "resources": {
              "limits": {
                "cpu": "100m"
              },
              "requests": {
                "cpu": "50m"
              }
            }
          }
        ],
        "volumes": [
          {
            "name": "redis-data",
            "persistentVolumeClaim": {
              "claimName": "redis-data-redis-master-0"
            }
          }
        ]
      }
    },
    "agent": {
      "model_type": "generative",
      "transparency": {
        "user_instructions_available": true
      },
      "logging_config": {
        "automatic_record_keeping": true
      },
      "audit_config": {
        "event_logging_enabled": true
      },
      "sbom": {
        "format": "SPDX",
        "verified": true
      },
      "provenance": {
        "slsa_level": "SLSA_LEVEL_2"
      },
      "security_profile": {}
    },
    "request": {
      "tool_call": {
        "action": "write_file"
      },
      "context": {
        "claims": [
          {
            "type": "human_approval_svid",
            "valid": false
          }
        ]
      },
      "peer": {
        "spiffe_id": "spiffe://signalloom.demo/ns/cache/sa/redis"
      },
      "source": {
        "namespace": "cache"
      },
      "destination": {
        "namespace": "agents"
      },
      "auth": {
        "svid_presented": true
      }
    }
  },
  "expect": {
    "no-automount-sa-token": "pass",
    "spiffe-peer-authorization": "pass",
    "cross-namespace-egress-authorization": "fail",
    "container-run-as-non-root": "fail",
    "no-privilege-escalation": "fail",
    "no-privileged-mode": "pass",
    "immutable-audit-sink": "pass",
    "read-only-rootfs": "fail",
    "mfa-spiffe-svid-required": "pass",
    "drop-all-capabilities": "fail",
    "network-boundary-enforcement": "fail",
    "anomaly-detection-telemetry": "fail",
    "image-digest": "fail",
    "trusted-registry": "fail",
    "no-host-ipc": "pass",
    "no-host-pid": "pass",
    "no-host-network": "pass"
  }
}