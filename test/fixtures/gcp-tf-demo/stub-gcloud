#!/usr/bin/env bash
#
# Stub `gcloud` for test/terraform-demo-driver.bats.
#
# Placed on PATH ahead of the real binary so scripts/gcp-tf/demo-up.sh executes
# its REAL control flow — resume, deliver, verify, run, collect, classify,
# verdict, tunnel — with no cloud access, no credentials and no network.
#
# Every invocation is appended to $STUB_GCLOUD_LOG together with the
# SSH_AUTH_SOCK the caller actually exported. That is what turns the ssh-agent
# guard and the impersonation guard from greps into behavioural assertions: the
# log records what the real gcloud would have SEEN, not what the source says.
#
# It models a VM FILESYSTEM ($STUB_VM_FS) rather than just returning canned exit
# codes. `compute scp` writes the payload into it and `compute ssh "stat -c %s
# …"` reads it back, so the driver's post-transfer size check runs against a
# real byte count. Without that the check could only be asserted by grep — and
# the defect it exists to catch is one where the exit code lies.
#
# It also emits the impersonation WARNING the real gcloud emits on every API
# call when --impersonate-service-account is passed. That warning broke
# vm_status in review (glued onto the status, so RUNNING never compared equal to
# anything), and a stub that stayed silent about it would never have shown that.
#
# Knobs:
#   STUB_GCLOUD_LOG        file to append invocations to
#   STUB_VM_FS             directory standing in for the VM's filesystem
#   STUB_VM_STATE          what `instances describe` reports (default RUNNING)
#   STUB_PIPELINE_RC       exit code for the remote pipeline (default 0)
#   STUB_REPORT_SRC        directory handed back as the collected report bundle.
#                          UNSET means collection FAILS — how "the run came back
#                          with no verdict" is reproduced.
#   STUB_DELIVERY_BYTES    truncate the delivered payload to N bytes, or the
#                          literal MISSING to deliver nothing at all. Models the
#                          transfer that reports success and lands zero bytes.
#   STUB_SCP_UP_RC         exit code for the code-delivery scp (default 0)
#   STUB_TUNNEL_RC         exit code for start-iap-tunnel (default 0)
#   STUB_TUNNEL_HOLD       seconds start-iap-tunnel stays alive (default 3)
#   STUB_TUNNEL_STDERR     text start-iap-tunnel writes to stderr
#   STUB_NO_WARNING        set to 1 to suppress the impersonation warning

log="${STUB_GCLOUD_LOG:-/dev/null}"
printf '%s\tSSH_AUTH_SOCK=[%s]\n' "$*" "${SSH_AUTH_SOCK-@UNSET@}" >>"$log"

argv="$*"

case "$argv" in
  *--impersonate-service-account=*)
    if [ "${STUB_NO_WARNING:-0}" != "1" ]; then
      printf 'WARNING: This command is using service account impersonation. All API calls will be executed as [stub-operator].\n' >&2
    fi
    ;;
esac

vm_fs="${STUB_VM_FS:-}"
delivery="${vm_fs}/delivery.tar.gz"

case "$argv" in
  *"instances describe"*)
    printf '%s\n' "${STUB_VM_STATE:-RUNNING}"
    exit 0
    ;;
  *"instances resume"* | *"instances start"* | *"instances suspend"*)
    printf 'stub-gcloud: instance state change\n'
    exit 0
    ;;
  *"start-iap-tunnel"*)
    [ -z "${STUB_TUNNEL_STDERR:-}" ] || printf '%s\n' "${STUB_TUNNEL_STDERR}" >&2
    [ "${STUB_TUNNEL_RC:-0}" = "0" ] || exit "${STUB_TUNNEL_RC}"
    printf 'Listening on port [%s].\n' "$2"
    sleep "${STUB_TUNNEL_HOLD:-3}"
    exit 0
    ;;
  *"compute scp"*)
    # The last argument tells upload from download apart: an upload's
    # destination is `instance:/path`, a download's is a local directory.
    dest="${*: -1}"
    src="${*: -2:1}"
    case "$dest" in
      *:*)
        [ "${STUB_SCP_UP_RC:-0}" = "0" ] || exit "${STUB_SCP_UP_RC}"
        [ -n "$vm_fs" ] || exit 0
        mkdir -p "$vm_fs"
        case "${STUB_DELIVERY_BYTES:-}" in
          "") cp "$src" "$delivery" ;;
          MISSING) rm -f "$delivery" ;;
          *) head -c "${STUB_DELIVERY_BYTES}" "$src" >"$delivery" ;;
        esac
        exit 0
        ;;
      *)
        # Collection. Hand back a bundle built from STUB_REPORT_SRC, named after
        # the archive the caller asked for, because demo-up.sh untars exactly
        # that basename out of the destination directory.
        [ -n "${STUB_REPORT_SRC:-}" ] || exit 1
        [ -d "${STUB_REPORT_SRC}" ] || exit 1
        remote_path="${src#*:}"
        tar -C "${STUB_REPORT_SRC}" -czf "${dest%/}/$(basename "$remote_path")" .
        exit 0
        ;;
    esac
    ;;
  *"compute ssh"*)
    case "$argv" in
      *"echo ready"*) exit 0 ;;
      *"stat -c %s"*)
        # The driver's post-transfer size check. Answering HONESTLY is the whole
        # point: a stub that always printed the expected number would make that
        # check untestable, which is the same shape as the defect it guards.
        if [ -n "$vm_fs" ] && [ -f "$delivery" ]; then
          wc -c <"$delivery" | tr -d '[:space:]'
          printf '\n'
        else
          printf 'MISSING\n'
        fi
        exit 0
        ;;
      *"demo-pipeline"*)
        printf 'stub-pipeline: stage output line 1\n'
        printf 'stub-pipeline: stage output line 2\n'
        exit "${STUB_PIPELINE_RC:-0}"
        ;;
      *"git init"*) exit 0 ;;
      *"-czf"*)
        # Packaging the remote report directory. Fails when the test has not
        # provided one, which is the honest model of a pipeline that died before
        # writing anything.
        [ -n "${STUB_REPORT_SRC:-}" ] || exit 1
        exit 0
        ;;
      *) exit 0 ;;
    esac
    ;;
esac

exit 0
