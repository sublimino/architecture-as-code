{
  "name": "bare-pod",
  "level": "integration",
  "description": "A minimal pod with one container and nothing else set; agent and request are empty. Shows the absent-field semantics: Kubernetes defaults, fail-closed governance, and the two pinned fail-open request/agent checks.",
  "input": {
    "object": {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "bare"
      },
      "spec": {
        "containers": [
          {
            "name": "app",
            "image": "busybox"
          }
        ]
      }
    },
    "agent": {},
    "request": {}
  },
  "expect": {
    "container-run-as-non-root": "fail",
    "no-privilege-escalation": "fail",
    "training-data-provenance": "fail",
    "annex-iv-technical-documentation": "fail",
    "automatic-record-keeping": "fail",
    "user-instructions-transparency": "fail",
    "block-unauthorized-host-exec": "pass",
    "drop-all-capabilities": "fail",
    "resource-limits-set": "fail",
    "deployer-monitoring-active": "fail",
    "synthetic-content-marking": "pass"
  }
}
