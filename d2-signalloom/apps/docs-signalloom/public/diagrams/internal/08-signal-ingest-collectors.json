  "edges": [
    [
      "aws",
      "registry",
      "collect"
    ],
    [
      "gcp",
      "registry",
      "collect"
    ],
    [
      "k8s",
      "registry",
      "collect"
    ],
    [
      "bao",
      "registry",
      "collect"
    ],
    [
      "spire",
      "registry",
      "collect"
    ],
    [
      "wss",
      "registry",
      "collect (planned)",
