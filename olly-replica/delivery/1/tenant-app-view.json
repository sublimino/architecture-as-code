              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "Critical": {
                        "color": "red",
                        "index": 0
                      },
                      "High": {
                        "color": "orange",
                        "index": 1
                      },
                      "Low": {
                        "color": "blue",
                        "index": 3
                      },
                      "Medium": {
                        "color": "yellow",
                        "index": 2
                      },
                      "Unknown": {
                        "color": "text",
                        "index": 4
                      }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          }
        ]
