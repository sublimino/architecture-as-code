# Copy to olly_sentinel/.env for local `adk web` / `adk eval` / `make olly-eval`.
# The agent runs deterministically with NO model configured — that is the
# reproducible eval baseline. A model is only needed for the RCA narrative and
# the optional LLM-judge eval metric. This file is gitignored.

# --- Contracts + evidence (local runs) -------------------------------------
# The committed payload + agent-card contracts (conftest sets this to the
# checkout automatically; override to point elsewhere).
# CONTRACTS_DIR=../../contracts
#
# Where the pipeline's read-only evidence fan-out goes. Default for offline
# eval/adk-web is the hermetic stub (make olly-adk-web starts it); point at a
# port-forwarded real MCP to drive the seeded cluster instead:
#   kubectl -n olly-replica port-forward svc/elk-search-mcp 8099:8080
MCP_URL=http://127.0.0.1:8099

# The green eval run this agent version demoed under (stamped into every
# enrichment's agent.eval_run_id). make olly-eval sets a timestamped value.
EVAL_RUN_ID=local-dev

# --- LLM narrator (optional) -----------------------------------------------
# Leave LLM_PROVIDER blank for deterministic RCA (the eval baseline).
#   LLM_PROVIDER: openrouter | anthropic | openai | ollama | gemini
#   LLM_MODEL:    provider model id (blank = a sensible per-provider default)
#   LLM_API_KEY:  required for openrouter/anthropic/openai; unused for ollama
#   LLM_URL:      ollama / custom OpenAI-compatible base
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_URL=

# --- Vertex AI / AI Studio (only for the LLM-judge eval metric) ------------
# The ADK-native path the codeathon demos use. For the final_response_match_v2
# judge metric, authenticate with `gcloud auth application-default login` and:
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# Alternative (AI Studio key): GOOGLE_API_KEY=your-key
