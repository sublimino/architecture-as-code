      "focal": true,
      "kind": "backend",
      "row": 3,
      "col": 1
    },
    {
      "id": "frostdb",
      "label": "FrostDB",
      "sub": "observations store",
      "kind": "store",
      "row": 4,
      "col": 1
    }
