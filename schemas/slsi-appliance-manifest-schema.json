{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalloom.io/schemas/slsi-appliance-manifest/v1",
  "title": "SLSI appliance manifest schema",
  "description": "Root schema validating MANIFEST.json in the SLSI tenant appliance bundle archive.",
  "type": "object",
  "required": [
    "schema",
    "bundle",
    "sourceDateEpoch",
    "git",
    "payload",
    "payloadFileCount",
    "payloadTotalBytes",
    "payloadChecksumFile",
    "images",
    "imageCount",
    "releaseKey",
    "verify",
    "coverageExclusions",
    "reproducibility"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "slsi-bundle/v1"
    },
    "bundle": {
      "type": "object",
      "required": [
        "name",
        "version",
        "createdAtUtc",
        "applianceModes"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^slsi-appliance-[0-9A-Za-z][0-9A-Za-z._-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]*$"
        },
        "createdAtUtc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "applianceModes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "applianceModes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hub": {
          "type": "object",
          "properties": {
            "rendersOverlay": {
              "type": [
                "string",
                "null"
              ]
            },
            "mintsIssuers": {
              "type": "boolean"
            }
          }
        },
        "attached": {
          "type": "object",
          "properties": {
            "rendersOverlay": {
              "type": [
                "string",
                "null"
              ]
            },
            "mintsIssuers": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "sourceDateEpoch": {
      "type": "integer",
      "minimum": 0
    },
    "git": {
      "type": "object",
      "required": [
        "commit",
        "branch",
        "dirty"
      ],
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "branch": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "payload": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "mode",
          "bytes"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/|\\.\\./|\\./).+"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mode": {
            "type": "string",
            "pattern": "^0[0-7]{3}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "payloadFileCount": {
      "type": "integer",
      "minimum": 1
    },
    "payloadTotalBytes": {
      "type": "integer",
      "minimum": 0
    },
    "payloadChecksumFile": {
      "const": "MANIFEST.sha256"
    },
    "payloadChecksums": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cwdAnchor": {
          "const": "."
        }
      }
    },
    "verify": {
      "type": "object",
      "required": [
        "root",
        "command"
      ],
      "additionalProperties": false,
      "properties": {
        "root": {
          "const": "."
        },
        "command": {
          "type": "string",
          "pattern": "sha256sum"
        }
      }
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ref",
          "digest"
        ],
        "properties": {
          "ref": {
            "type": "string"
          },
          "resolvedRef": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "logicalName": {
            "type": "string"
          },
          "sourceRef": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "party": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "provides": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "digestKind": {
            "type": "string"
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ociLayoutPath": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer"
          },
          "keyFingerprint": {
            "type": "string"
          },
          "signature": {
            "type": [
              "object",
              "string",
              "null"
            ]
          },
          "provenance": {
            "type": "object"
          }
        }
      }
    },
    "imageCount": {
      "type": "integer",
      "minimum": 1
    },
    "containerisedUtilities": {
      "type": "object",
      "required": [
        "imageRef",
        "imageDigest",
        "utilities",
        "runtimeRequired",
        "onAbsentRemedy"
      ],
      "additionalProperties": false,
      "properties": {
        "imageRef": {
          "type": "string"
        },
        "imageDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "utilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtimeRequired": {
          "type": "string"
        },
        "onAbsentRemedy": {
          "type": "string"
        }
      }
    },
    "stagedBinaries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "arch": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mode": {
            "type": "string"
          }
        }
      }
    },
    "buildHostPrerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "releaseKey": {
      "type": "object",
      "required": [
        "fingerprint",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "path": {
          "type": "string"
        },
        "algorithm": {
          "type": "string"
        },
        "keyUri": {
          "type": "string"
        },
        "publicKeyPath": {
          "type": "string"
        }
      }
    },
    "provenanceStatement": {
      "type": "string"
    },
    "installer": {
      "type": "object",
      "required": [
        "path",
        "present",
        "status",
        "ownedBy",
        "governedBy"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "present": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "ownedBy": {
          "type": "string"
        },
        "governedBy": {
          "type": "string"
        }
      }
    },
    "bundleLayout": {
      "type": "object",
      "properties": {
        "fleet": {
          "type": "string"
        },
        "infra": {
          "type": "string"
        },
        "bin": {
          "type": "string"
        },
        "images": {
          "type": "string"
        },
        "keys": {
          "type": "string"
        },
        "installer": {
          "type": "string"
        }
      }
    },
    "ociArtifacts": {
      "type": "array"
    },
    "fluxVendoring": {
      "type": "object"
    },
    "coverageExclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "reason",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "helm-chart-repository",
              "local-never-pulled"
            ]
          },
          "kind": {
            "type": "string"
          }
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "description": "Declares how two builds from the same sourceDateEpoch may legitimately differ. Without this block a governor comparing builds must invent which differences to forgive, which is a tautological pass.",
      "required": [
        "sourceDateEpoch",
        "comparisonRule",
        "volatileSet"
      ],
      "additionalProperties": false,
      "properties": {
        "sourceDateEpoch": {
          "type": "integer",
          "description": "Epoch the build pins timestamps to; must equal the root sourceDateEpoch."
        },
        "comparisonRule": {
          "type": "string",
          "minLength": 80,
          "description": "States that a difference outside the volatile set fails the gate."
        },
        "volatileSet": {
          "type": "array",
          "minItems": 1,
          "description": "Payload path globs that cannot be byte-reproducible, each with a machine-readable reason.",
          "items": {
            "type": "object",
            "required": [
              "glob",
              "reason",
              "detail"
            ],
            "additionalProperties": false,
            "properties": {
              "glob": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "enum": [
                  "cosign-ecdsa-nonce",
                  "derived-from-volatile"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 40
              }
            }
          }
        }
      }
    }
  }
}
