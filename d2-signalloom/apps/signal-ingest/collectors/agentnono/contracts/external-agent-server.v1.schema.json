{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://signalloom.controlplane.io/contracts/external-agent-server.v1.schema.json","title":"ExternalAgentServerProjectionV1","oneOf":[{"$ref":"#/$defs/enrollment_result"},{"$ref":"#/$defs/upload_result"},{"$ref":"#/$defs/evidence_page"},{"$ref":"#/$defs/revocation_result"},{"$ref":"#/$defs/error"}],
  "$defs":{
    "integrity_result":{"description":"Local-only projection from agentnono using trusted raw events; never nested in evidence_page.","type":"object","additionalProperties":false,"required":["authority","session_id","event_count","final_digest","state","evaluated_at","reason"],"properties":{"authority":{"const":"agentnono-go-v1"},"session_id":{"type":"string","pattern":"^[A-Za-z0-9-]{3,128}$"},"event_count":{"type":"integer","minimum":0,"maximum":100000},"final_digest":{"oneOf":[{"type":"string","pattern":"^[0-9a-f]{64}$"},{"type":"null"}]},"state":{"enum":["integrity-verified","tampered","unavailable"]},"evaluated_at":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"},"reason":{"enum":["verified","verifier-unavailable","empty-chain","event-cap-exceeded","not-finalized","chain-continuity-failed","event-tampered","event-unverified"]}},"oneOf":[{"properties":{"state":{"const":"integrity-verified"},"reason":{"const":"verified"},"event_count":{"minimum":1},"final_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},{"properties":{"state":{"const":"tampered"},"reason":{"enum":["chain-continuity-failed","event-tampered"]},"event_count":{"minimum":1},"final_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},{"properties":{"state":{"const":"unavailable"},"reason":{"enum":["verifier-unavailable","empty-chain","event-cap-exceeded","not-finalized","event-unverified"]},"event_count":{"const":0},"final_digest":{"type":"null"}}}]},
    "enrollment_result":{"type":"object","additionalProperties":false,"required":["schema_version","tenant_id","agent_id","host_id","key_id","enrollment_state","credential_kind","credential_scope","credential_bootstrap","credential_reference","credential_expires_at","revocation_endpoint"],"properties":{"schema_version":{"const":"1.0.0"},"tenant_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,63}$"},"agent_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,63}$"},"host_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,63}$"},"key_id":{"type":"string","pattern":"^[A-Za-z0-9._:-]{3,128}$"},"enrollment_state":{"const":"enrolled"},"credential_kind":{"const":"existing-mtls-identity"},"credential_scope":{"const":"audit-upload-only"},"credential_bootstrap":{"const":"pre-provisioned-out-of-band"},"credential_reference":{"type":"string","maxLength":512,"pattern":"^spiffe://[A-Za-z0-9._~:/-]+$"},"credential_expires_at":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"},"revocation_endpoint":{"type":"string","maxLength":256,"pattern":"^/v1/external-agents/[a-z][a-z0-9-]{2,63}/revocations$"}}},
    "upload_result":{"type":"object","additionalProperties":false,"required":["schema_version","upload_id","replay_result","host_signature_state","original_chain_state"],"properties":{"schema_version":{"const":"1.0.0"},"upload_id":{"type":"string","pattern":"^[A-Za-z0-9-]{16,128}$"},"replay_result":{"enum":["accepted","idempotent-replay"]},"host_signature_state":{"const":"host-signature-verified"},"original_chain_state":{"const":"original-chain-not-verified"}}},
    "server_evidence":{"description":"Host observation preserved by the server without provenance relabeling.","type":"object","additionalProperties":false,"required":["schema_version","session_id","sequence","observed_at","source","evidence_type","observation_state","integrity_state","agent_id","host_id","attributes"],"properties":{"schema_version":{"const":"1.0.0"},"session_id":{"type":"string","pattern":"^[A-Za-z0-9-]{3,128}$"},"sequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"observed_at":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"},"source":{"enum":["nono-0.73.0","host-sensor-v1"]},"evidence_type":{"enum":["process","artifact","network","collection-limit"]},"observation_state":{"enum":["observed","denied","unobserved"]},"integrity_state":{"const":"not-integrity-verified"},"agent_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,63}$"},"host_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,63}$"},"attributes":{"oneOf":[{"$ref":"external-agent-evidence.v1.schema.json#/$defs/process"},{"$ref":"external-agent-evidence.v1.schema.json#/$defs/artifact"},{"$ref":"external-agent-evidence.v1.schema.json#/$defs/network"},{"$ref":"external-agent-evidence.v1.schema.json#/$defs/limit"}]}},"allOf":[{"if":{"properties":{"evidence_type":{"const":"process"}}},"then":{"properties":{"attributes":{"$ref":"external-agent-evidence.v1.schema.json#/$defs/process"}}}},{"if":{"properties":{"evidence_type":{"const":"artifact"}}},"then":{"properties":{"attributes":{"$ref":"external-agent-evidence.v1.schema.json#/$defs/artifact"}}}},{"if":{"properties":{"evidence_type":{"const":"network"}}},"then":{"properties":{"attributes":{"$ref":"external-agent-evidence.v1.schema.json#/$defs/network"}}}},{"if":{"properties":{"evidence_type":{"const":"collection-limit"}}},"then":{"properties":{"observation_state":{"const":"unobserved"