    },
    {
      "id": "GW-TRAV-1",
      "vector": "dot-segment-traversal",
      "method": "GET",
      "path": "/api/v1/../admin",
      "expected": "404(normalized,reached-backend)",
      "observed_code": "404",
      "severity": "pass",
      "summary": "Envoy normalizes dot-segments before routing (RFC 3986): /api/v1/../admin -> /api/admin, still matches the /api prefix, backend 404s cleanly -- no traversal outside the matched backend"
    },
    {
      "id": "GW-TRAV-2",
      "vector": "encoded-dot-segment-traversal",
      "method": "GET",
      "path": "/api/%2e%2e/%2e%2e/etc/passwd",
      "expected": "200(normalized-to-SPA-fallback)",
      "observed_code": "200",
      "severity": "pass",
      "summary": "percent-encoded dot-segments are decoded+collapsed before routing: /api/%2e%2e/%2e%2e/etc/passwd -> /etc/passwd, which matches no HTTPRoute prefix and falls to the dashboard SPA's catch-all (index.html, not a filesystem read)"
    },
    {
      "id": "GW-TRAV-3",
      "vector": "double-leading-slash",
      "method": "GET",
      "path": "//api",
      "expected": "404(merged,reached-backend)",
      "observed_code": "404",
      "severity": "pass",
      "summary": "leading double slash is merged before routing; reaches the same backend 404 as a bare /api"
    },
    {
      "id": "GW-TRAV-4",
      "vector": "encoded-slash-in-path",
      "method": "GET",
      "path": "/api/..%2f..%2fadmin",
      "expected": "307(path_normalization_failed,no-backend-contacted)",
      "observed_code": "307",
      "severity": "pass",
      "summary": "percent-encoded slash (%2f) inside a path segment is rejected by Envoy's own path_normalization_failed handling: it returns a 307 to the canonicalized path WITHOUT ever selecting a route or contacting a backend (verified via access log: upstream_cluster=null, response_code_details=path_normalization_failed) -- no differential parsing between Envoy and the backend was observed"
    },
    {
