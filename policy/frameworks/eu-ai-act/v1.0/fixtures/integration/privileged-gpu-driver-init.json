{
  "name": "privileged-gpu-driver-init",
  "level": "integration",
  "description": "High-risk vision-inference pod whose GPU driver loader init container runs privileged as root to insert the kernel module and create the device nodes. The serving container is fully hardened, so the privileged, root, escalation and capability verdicts are attributable to the init container alone.",
  "input": {
    "object": {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "vision-inference-5c8b",
        "namespace": "ai-inference",
        "labels": {
          "app": "vision-inference",
          "version": "2.1.0",
          "data_classification": "confidential",
          "ai_human_oversight": "human-on-the-loop",
          "policy_version": "v2.0.0"
        },
        "annotations": {
          "osramp.io/pii-handling": "pseudonymised",
          "osramp.io/data-retention": "90d",
          "osramp.io/approval-gate": "required",
          "osramp.io/override-contact": "oncall@example.com"
        }
      },
      "spec": {
        "serviceAccountName": "vision-inference",
        "automountServiceAccountToken": false,
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 10001,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "initContainers": [
          {
            "name": "load-gpu-driver",
            "image": "registry.internal/gpu-driver-loader@sha256:a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90",
            "args": [
              "modprobe",
              "nvidia"
            ],
            "securityContext": {
              "privileged": true,
              "runAsUser": 0,
              "readOnlyRootFilesystem": true
            },
            "resources": {
              "limits": {
                "cpu": "200m",
                "memory": "256Mi"
              },
              "requests": {
                "cpu": "50m",
                "memory": "128Mi"
              }
            },
            "volumeMounts": [
              {
                "name": "dev",
                "mountPath": "/dev"
              }
            ]
          }
        ],
        "containers": [
          {
            "name": "inference",
            "image": "registry.internal/vision-inference@sha256:b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90a1",
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "privileged": false,
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "resources": {
              "limits": {
                "cpu": "2",
                "memory": "8Gi"
              },
              "requests": {
                "cpu": "1",
                "memory": "4Gi"
              }
            },
            "livenessProbe": {
              "httpGet": {
                "path": "/healthz",
                "port": 8080
              },
              "periodSeconds": 10
            },
            "readinessProbe": {
              "httpGet": {
                "path": "/readyz",
                "port": 8080
              },
              "periodSeconds": 10
            },
            "volumeMounts": [
              {
                "name": "models",
                "mountPath": "/models",
                "readOnly": true
              },
              {
                "name": "tmp",
                "mountPath": "/tmp"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "dev",
            "hostPath": {
              "path": "/dev"
            }
          },
          {
            "name": "models",
            "emptyDir": {}
          },
          {
            "name": "tmp",
            "emptyDir": {
              "medium": "Memory"
            }
          }
        ]
      }
    },
    "agent": {},
    "request": {}
  },
  "expect": {
    "container-run-as-non-root": "fail",
    "no-privilege-escalation": "fail",
    "no-privileged-mode": "fail",
    "data-classification-label": "pass",
    "hitl-label": "pass",
    "resource-limits-set": "pass",
    "image-digest-required": "pass"
  }
}
