#!/usr/bin/env bash
#
# Stub `gcloud` for test/terraform-tailscale-access.bats.
#
# A sibling of test/fixtures/gcp-tf-demo/stub-gcloud rather than a reuse of it.
# That one models delivery, the pipeline and report collection; this one models
# the handful of remote commands the Tailscale path issues, and models them
# SEPARATELY so a funnel that fails and a serve that fails are distinguishable.
# Sharing one stub would have meant a single exit code standing in for four
# different remote outcomes, which is the shape that makes a red test ambiguous.
#
# Every invocation is appended to $STUB_GCLOUD_LOG together with the
# SSH_AUTH_SOCK the caller actually exported, so the ssh-agent and impersonation
# guards stay behavioural assertions rather than greps — and so a test can
# assert that NOTHING reached the cloud before a local check failed.
#
# Knobs:
#   STUB_GCLOUD_LOG        file to append invocations to
#   STUB_VM_STATE          what `instances describe` reports (default RUNNING)
#   STUB_VM_PUBLISHING     1 (default) => `ss -ltn` reports the port bound, so
#                          remote_is_publishing sees a listener. 0 => absent.
#   STUB_PF_RC             exit code for the dashboard-forward install step. The
#                          real script exits 3/4/5/6/7/8/9 for causes that need
#                          different answers (no kubectl, no kubeconfig, no
#                          service, cannot write the unit, cannot start it,
#                          nothing ever listened), and each is separately
#                          reachable here for the same reason serve and funnel
#                          are: one code standing in for seven outcomes makes a
#                          red test ambiguous.
#   STUB_PF_LISTENING      1 (default) => the forward reports PUBLISHED.
#                          0 => it reports NOT_PUBLISHED and exits 9,
#                          which is the unit-started-and-nothing-bound case.
#   STUB_PF_UNIT_CHANGED   what the install step reports for unit_changed
#                          (default 0 — an already-correct unit is not rewritten,
#                          because rewriting restarts it and Dex keeps sessions
#                          in memory).
#   STUB_PF_UNIT_STATE     what `systemctl is-active` reports to ts-status
#                          (default active)
#   STUB_VM_ALIAS_RC       exit code for the /etc/hosts alias step. RETAINED for
#                          the IAP path only — the Tailscale path no longer
#                          touches /etc/hosts, and a test asserts it does not.
#   STUB_TS_SERVE_RC       exit code for a remote `tailscale serve`
#   STUB_TS_FUNNEL_RC      exit code for a remote `tailscale funnel --bg`
#   STUB_TS_FUNNEL_OFF_RC  exit code for a remote `tailscale funnel ... off`
#   STUB_NO_WARNING        1 => suppress the impersonation warning
#   STUB_TS_NAME_MARKER    contents of /var/lib/signalloom/tailscale-name-mismatch
#                          on the VM. EMPTY by default, which is the healthy
#                          state — the node got the name it asked for.
#   STUB_TS_ABSENT         1 => no tailscale client on the VM, so `command -v`
#                          fails. Models a VM whose optional tailscale stage
#                          never ran.
#   STUB_TS_LOGOUT_RC      exit code for a remote `tailscale logout`
#   STUB_TS_SERVE_JSON     what `tailscale serve status --json` prints.
#                          Defaults to "{}", which is what the real client
#                          emits for an empty config (tailscale 1.102.3).
#   STUB_TS_SERVE_JSON_SILENT
#                          1 => `--json` fails and prints nothing, modelling a
#                          build without --json support. Exercises the driver's
#                          prose fallback.
#   STUB_TS_SERVE_STATUS   what `tailscale serve status` prints. Defaults to
#                          "No serve config", the literal that means nothing is
#                          configured.
#   STUB_TS_SERVE_SILENT   1 => `serve status` fails and prints nothing, which
#                          is what an unreachable node or a refused sudo does.
#                          The driver must read this as UNKNOWN, not absent.

log="${STUB_GCLOUD_LOG:-/dev/null}"
printf '%s\tSSH_AUTH_SOCK=[%s]\n' "$*" "${SSH_AUTH_SOCK-@UNSET@}" >>"$log"

argv="$*"

# The real gcloud emits this on EVERY underlying API call when impersonating,
# and it broke vm_status in review by gluing itself onto the status string. A
# stub that stayed silent about it would never show that again.
case "$argv" in
  *--impersonate-service-account=*)
    if [ "${STUB_NO_WARNING:-0}" != "1" ]; then
      printf 'WARNING: This command is using service account impersonation. All API calls will be executed as [stub-operator].\n' >&2
    fi
    ;;
esac

case "$argv" in
  *"instances describe"*)
    printf '%s\n' "${STUB_VM_STATE:-RUNNING}"
    exit 0
    ;;
  *"instances resume"* | *"instances start"* | *"instances suspend"*)
    exit 0
    ;;
  *"compute ssh"*)
    # Ordered most specific first. `tailscale funnel ... off` and
    # `tailscale funnel --bg ...` both contain "tailscale funnel", so the off
    # branch has to be tested first or turning funnel off would be scored as
    # turning it on — which would make funnel-down's test pass against a stub
    # that never modelled it.
    case "$argv" in
      # BEFORE the `ss -ltn` branch, and that ordering is load-bearing. The
      # forward-install script polls with `ss -ltn` itself, so the generic
      # branch below would swallow the whole thing and answer PUBLISHING
      # without ever reaching the unit install — the stub, not the driver,
      # deciding the outcome.
      #
      # Matched on `port-forward`, which appears in ensure_published's install
      # script and in no other remote command any access method issues.
      #
      # The words below are ensure_published's OWN vocabulary and must stay that
      # way: PUBLISHED / NOT_PUBLISHED, not a name invented here. A stub that
      # answers in a dialect the caller does not speak keeps every test green
      # while the two disagree, which is why the SEAM test in
      # test/terraform-tailscale-access.bats asserts these markers still exist in
      # the driver.
      *"port-forward"*)
        [ "${STUB_PF_RC:-0}" = "0" ] || exit "${STUB_PF_RC}"
        printf 'dashboard=fe-signalloom/dashboard-signalloom\n'
        printf 'unit_changed=%s\n' "${STUB_PF_UNIT_CHANGED:-0}"
        if [ "${STUB_PF_LISTENING:-1}" = "1" ]; then
          printf 'PUBLISHED\n'
          exit 0
        fi
        printf 'NOT_PUBLISHED\n' >&2
        exit 9
        ;;
      *"systemctl disable"*)
        # public-down. STOPPED unless a test asks for the stuck case.
        [ "${STUB_PF_DISABLE_STUCK:-0}" = "1" ] && { printf 'STILL_PUBLISHING\n'; exit 0; }
        printf 'STOPPED\n'
        exit 0
        ;;
      *"systemctl is-active"*)
        printf '%s\n' "${STUB_PF_UNIT_STATE:-active}"
        exit 0
        ;;
      *"tailscale funnel"*" off"*)
        [ "${STUB_TS_FUNNEL_OFF_RC:-0}" = "0" ] || exit "${STUB_TS_FUNNEL_OFF_RC}"
        printf 'FUNNEL_OFF\n'
        exit 0
        ;;
      *"tailscale funnel"*)
        [ "${STUB_TS_FUNNEL_RC:-0}" = "0" ] || {
          printf 'funnel is not enabled for this tailnet\n' >&2
          exit "${STUB_TS_FUNNEL_RC}"
        }
        printf 'FUNNEL_CONFIGURED\n'
        exit 0
        ;;
      # THREE serve arms, most specific first, and the ordering is the whole
      # correctness argument. `serve status --json` contains `serve status`
      # contains `serve`, so any looser order answers the wrong question — and
      # the generic arm answering SERVE_CONFIGURED to a read-only status query
      # is precisely what made every unforced ts-logout look like it was
      # running against a serving node.
      *"tailscale serve status --json"*)
        # `{}` is what the real client emits for an empty config (measured on
        # tailscale 1.102.3). Default to it so tests that are not about serve
        # keep the behaviour they had.
        #
        # STUB_TS_SERVE_JSON_SILENT models a build with no --json support, which
        # is the case the driver's prose fallback exists for.
        [ "${STUB_TS_SERVE_JSON_SILENT:-0}" != "1" ] || exit 1
        # The default goes through a variable rather than inline. Both obvious
        # inline spellings are wrong: "${VAR:-\{\}}" keeps the backslashes
        # literally (\{ is not an escape bash recognises inside double quotes,
        # so the stub emitted \{\} and every idle node read as SERVING), and
        # "${VAR:-{}}" ends the expansion at the first brace.
        serve_json_default='{}'
        printf '%s\n' "${STUB_TS_SERVE_JSON:-$serve_json_default}"
        exit 0
        ;;
      *"tailscale serve status"*)
        # `No serve config` is the literal tailscale prints when nothing is
        # configured, and it is the ONLY positive evidence of absence. Default
        # to it so every pre-existing test keeps the behaviour it had.
        #
        # STUB_TS_SERVE_SILENT models the cases that produce no output at all —
        # SSH failed, sudo refused, tailscaled is down — which the driver must
        # treat as "unknown", never as "absent".
        [ "${STUB_TS_SERVE_SILENT:-0}" != "1" ] || exit 1
        printf '%s\n' "${STUB_TS_SERVE_STATUS:-No serve config}"
        exit 0
        ;;
      *"tailscale serve"*)
        [ "${STUB_TS_SERVE_RC:-0}" = "0" ] || {
          printf 'could not get certificate for this node\n' >&2
          exit "${STUB_TS_SERVE_RC}"
        }
        printf 'SERVE_CONFIGURED\n'
        exit 0
        ;;
      *"/etc/hosts"*)
        [ "${STUB_VM_ALIAS_RC:-0}" = "0" ] || exit "${STUB_VM_ALIAS_RC}"
        printf 'ALIAS_OK\n'
        exit 0
        ;;
      *"ss -ltn"*)
        # remote_is_publishing greps this for PUBLISHING. Answering honestly to
        # the knob is what lets a test drive ensure_published's slow path.
        if [ "${STUB_VM_PUBLISHING:-1}" = "1" ]; then
          printf 'PUBLISHING\n'
        else
          printf 'ABSENT\n'
        fi
        exit 0
        ;;
      # Ordered before the generic catch-all, and each of these three has a
      # DEFAULT that is the healthy answer, so every existing test keeps the
      # behaviour it had before these branches existed.
      *"tailscale-name-mismatch"*)
        # The name-mismatch marker demo-up.sh reads in `status` and `ts-status`.
        # Default EMPTY, which is "no mismatch recorded" — the state of every
        # healthy VM and of every test that is not about this.
        printf '%s' "${STUB_TS_NAME_MARKER:-}"
        exit 0
        ;;
      *"command -v tailscale"*)
        # Whether the VM has a tailscale client at all. Default present.
        [ "${STUB_TS_ABSENT:-0}" != "1" ] || exit 1
        exit 0
        ;;
      *"tailscale logout"*)
        [ "${STUB_TS_LOGOUT_RC:-0}" = "0" ] || {
          printf 'logout failed: not logged in\n' >&2
          exit "${STUB_TS_LOGOUT_RC}"
        }
        printf 'LOGGED_OUT\n'
        exit 0
        ;;
      *"echo ready"*) exit 0 ;;
      *) exit 0 ;;
    esac
    ;;
esac

exit 0
