{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://signalloom.controlplane.io/contracts/external-agent-upload.v1.schema.json","title":"ExternalAgentUploadV1","type":"object","additionalProperties":false,
  "required":["schema_version","upload_id","replay_key","session_id","sequence_start","sequence_end","assertion_envelope","original_chain_reference"],
  "properties":{
    "schema_version":{"const":"1.0.0"},"upload_id":{"type":"string","pattern":"^[A-Za-z0-9-]{16,128}$"},"replay_key":{"type":"string","pattern":"^[0-9a-f]{64}$"},"session_id":{"type":"string","pattern":"^[A-Za-z0-9-]{3,128}$"},
    "sequence_start":{"type":"integer","minimum":0,"maximum":9007199254740991},"sequence_end":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "assertion_envelope":{"$ref":"#/$defs/host_assertion_envelope"},"original_chain_reference":{"$ref":"#/$defs/original_chain_reference"}
  },
  "$defs":{
    "host_assertion_envelope":{"type":"object","additionalProperties":false,"required":["format","algorithm","payload_sha256","key_id","signature","assertions"],"properties":{"format":{"const":"signalloom-host-assertions-v1"},"algorithm":{"const":"Ed25519"},"payload_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"key_id":{"type":"string","pattern":"^[A-Za-z0-9._:-]{3,128}$"},"signature":{"type":"string","pattern":"^[A-Za-z0-9_-]{85}[AQgw]$"},"assertions":{"type":"array","minItems":1,"maxItems":500,"items":{"$ref":"external-agent-evidence.v1.schema.json"}}}},
    "original_chain_reference":{"description":"Untrusted host claim; never a server verification result.","type":"object","additionalProperties":false,"required":["session_id","event_count","final_digest"],"properties":{"session_id":{"type":"string","pattern":"^[A-Za-z0-9-]{3,128}$"},"event_count":{"type":"integer","minimum":1,"maximum":100000},"final_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
  },
  "x-signalloom-semantics":{"canonical-bytes":"UTF-8 JSON with lexicographically sorted keys, no insignificant whitespace, ASCII string values, and canonical base-10 safe integers without fractions, exponents, leading zeroes, or negative zero","signature":"Ed25519 over canonical bytes","payload_sha256":"lowercase SHA-256 of canonical bytes","replay_key":"equals payload_sha256","binding":"key_id plus every agent_id and host_id must equal trusted pre-registration","original-chain-reference":"untrusted host claim only; server cannot infer original integrity from this upload","inbound-integrity-authority":false,"schema-validity-is-cryptographic-validity":false}
}
