{
  "name": "malformed-no-spec",
  "level": "unit",
  "description": "Deliberately malformed: a Pod with metadata but no spec. Every spec-reading check must return error (not fail, not pass); only the metadata-only namespace check evaluates.",
  "input": {
    "object": {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "malformed-no-spec",
        "namespace": "payments"
      }
    },
    "agent": {},
    "request": {}
  },
  "expect": {
    "sa-token-automount-disabled": "error",
    "no-privileged-containers": "error",
    "no-host-pid": "error",
    "no-host-ipc": "error",
    "no-host-network": "error",
    "no-privilege-escalation": "error",
    "no-root-containers": "error",
    "no-net-raw": "error",
    "no-added-capabilities": "error",
    "capabilities-dropped-all": "error",
    "no-windows-hostprocess": "error",
    "no-hostpath-volumes": "error",
    "no-host-ports": "error",
    "no-secrets-in-env": "error",
    "seccomp-runtime-default": "error",
    "security-context-applied": "error",
    "no-default-namespace": "pass"
  }
}
