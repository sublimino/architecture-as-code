{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalloom.controlplane.io/schemas/coding-agent-telemetry.v1.schema.json",
  "title": "CodingAgentTelemetryV1",
  "description": "Closed, type-safe, length-bounded coding agent detective telemetry schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "harness",
    "session_id",
    "timestamp",
    "process",
    "kanban",
    "metrics",
    "network"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "harness": {
      "type": "string",
      "enum": [
        "claude",
        "antigravity",
        "codex",
        "cpai",
        "opencode",
        "hermes",
        "aider",
        "unknown"
      ],
      "maxLength": 32,
      "pattern": "^[a-z0-9_-]{1,32}$"
    },
    "session_id": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 35,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 35,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "agent_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "host_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "process": {
      "$ref": "#/$defs/process_info"
    },
    "kanban": {
      "$ref": "#/$defs/kanban_info"
    },
    "metrics": {
      "$ref": "#/$defs/metrics_info"
    },
    "network": {
      "$ref": "#/$defs/network_info"
    }
  },
  "$defs": {
    "process_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "ppid",
        "comm",
        "rss_bytes",
        "cpu_ticks"
      ],
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "ppid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194304
        },
        "comm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9_.-]{1,16}$"
        },
        "rss_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cpu_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "kanban_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "shortcode",
        "role",
        "elapsed_s"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z0-9_-]{1,64}$"
        },
        "shortcode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16,
          "pattern": "^[A-Z0-9]{2,16}$"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z0-9_-]{1,32}$"
        },
        "elapsed_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "metrics_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_count",
        "tokens_in",
        "tokens_out",
        "tool_counts"
      ],
      "properties": {
        "step_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokens_in": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokens_out": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tool_counts": {
          "$ref": "#/$defs/tool_counts"
        }
      }
    },
    "tool_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_file",
        "write_to_file",
        "replace_file_content",
        "run_command",
        "grep_search",
        "find_by_name",
        "list_dir",
        "read_url_content",
        "search_web",
        "invoke_subagent",
        "send_message",
        "manage_task",
        "ask_question",
        "other_count"
      ],
      "properties": {
        "view_file": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "write_to_file": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "replace_file_content": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "run_command": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "grep_search": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "find_by_name": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "list_dir": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "read_url_content": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "search_web": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "invoke_subagent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "send_message": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "manage_task": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ask_question": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "other_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "network_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inference_endpoint",
        "egress_bytes"
      ],
      "properties": {
        "inference_endpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9.-]{1,128}$"
        },
        "egress_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
