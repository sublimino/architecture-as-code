# Drop-in configuration for signalloom-portforward.service
# Place in ~/.config/systemd/user/signalloom-portforward.service.d/10-port-override.conf
# Apply with: systemctl --user daemon-reload && systemctl --user restart signalloom-portforward

[Service]
# Override the local port to bind (default: 5173)
Environment=LOCAL_PORT=5174

# Override the listen address (default: 127.0.0.1)
# Environment=LISTEN_ADDRESS=0.0.0.0

# Override the target namespace or service
# Environment=NAMESPACE=fe-signalloom
# Environment=SERVICE=svc/dashboard-signalloom
# Environment=REMOTE_PORT=8080
