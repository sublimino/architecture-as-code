74, "no_speech_prob": 0.0008411462185904384, "words": null, "temperature": 0.0}, {"id": 41, "seek": 8378, "start": 104.54, "end": 106.9, "text": " and the tail your board actually fears", "tokens": [51401, 290, 262, 7894, 534, 3096, 1682, 10251, 51519], "avg_logprob": -0.07823000122339298, "compression_ratio": 1.6074074074074074, "no_speech_prob": 0.0008411462185904384, "words": null, "temperature": 0.0}, {"id": 42, "seek": 8378, "start": 106.9, "end": 109.26, "text": " the insurance industry's own maths.", "tokens": [51519, 262, 5096, 2831, 338, 898, 47761, 13, 51637], "avg_logprob": -0.07823000122339298, "compression_ratio": 1.6074074074074074, "no_speech_prob": 0.0008411462185904384, "words": null, "temperature": 0.0}, {"id": 43, "seek": 8378, "start": 109.26, "end": 111.6, "text": " Tighten the control, the number falls.", "tokens": [51637, 44643, 268, 262, 1630, 11, 262, 1271, 8953, 13, 51754], "avg_logprob": -0.07823000122339298, "compression_ratio": 1.6074074074074074, "no_speech_prob": 0.0008411462185904384, "words": null, "temperature": 0.0}, {"id": 44, "seek": 8378, "start": 111.6, "end": 113.74000000000001, "text": " Accept a risk, it rises.", "tokens": [51754, 21699, 257, 2526, 11, 340, 16736, 13, 51861], "avg_logprob": -0.07823000122339298, "compression_ratio": 1.6074074074074074, "no_speech_prob": 0.0008411462185904384, "words": null, "temperature": 0.0}, {"id": 45, "seek": 11374, "start": 113.74000000000001, "end": 115.58000000000001, "text": " Live on screen.", "tokens": [50363, 7547, 319, 3159, 13, 50455], "avg_logprob": -0.09254086192126747, "compression_ratio": 1.5924528301886793, "no_speech_prob": 0.025908133015036583, "words": null, "temperature": 0.0}, {"id": 46, "seek": 11374, "start": 115.58000000000001, "end": 118.58000000000001, "text": " So we kill the ugliest word in governance.", "tokens": [50455, 1406, 356, 1494, 262, 334, 70, 11318, 1573, 287, 18848, 13, 50605], "avg_logprob": -0.09254086192126747, "compression_ratio": 1.5924528301886793, "no_speech_prob": 0.025908133015036583, "words": null, "temperature": 0.0}, {"id": 47, "seek": 11374, "start": 118.58000000000001, "end": 121.62, "text": " Exemption, no carve outs, no favors.", "tokens": [50605, 1475, 11221, 11, 645, 36717, 12198, 11, 645, 23866, 13, 50757], "avg_logprob": -0.09254086192126747, "compression_ratio": 1.5924528301886793, "no_speech_prob": 0.025908133015036583, "words": null, "temperature": 0.0}, {"id": 48, "seek": 11374, "start": 121.62, "end": 124.94000000000001, "text": " Instead, you may do this if you meet these conditions.", "tokens": [50757, 5455, 11, 345, 743, 466, 428, 611, 345, 1826, 777, 3403, 13, 50923], "avg_logprob": -0.09254086192126747, "compression_ratio": 1.5924528301886793, "no_speech_prob": 0.025908133015036583, "words": null, "temperature": 0.0}, {"id": 49, "seek": 11374, "start": 124.94000000000001, "end": 127.30000000000001, "text": " Uniform version priced.", "tokens": [50923, 35712, 2196, 19744, 13, 51041], "avg_logprob": -0.09254086192126747, "compression_ratio": 1.5924528301886793, "no_speech_prob": 0.025908133015036583, "words": null, "temperature": 0.0}, {"id": 50, "seek": 11374, "start": 127.30000000000001, "end": 129.84, "text": " Every allowance carries its own honest line", "tokens": [51041, 3887, 24930, 10732, 663, 898, 5508, 1627, 51168], "avg_logprob": -0.09254086192126747, "compression_ratio": 1.5924528301886793, "no_speech_prob": 0.025908133015036583, "words": null, "temperature": 0.0}, {"id": 51, "seek": 11374, "start": 129.84, "end": 131.02, "text": " of accepted risk.", "tokens": [51168, 286, 6292, 2526, 13, 51227], "avg_logprob": -0.09254086192126747, "compression_ratio": 1.5924528301886793, "no_speech_prob": 0.025908133015036583, "words": null, "temperature": 0.0}, {"id": 52, "seek": 11374, "start": 131.02, "end": 132.12, "text": " Here's the leap.", "tokens": [51227, 3423, 338, 262, 16470, 13, 51282], "avg_logprob": -0.09254086192126747, "compression_ratio": 1.5924528301886793, "no_speech_prob": 0.025908133015036583, "words": null, "temperature": 0.0}, {"id": 53, "seek": 11374, "start": 132.12, "end": 135.26000000000002, "text": " The policy version you satisfy becomes your identity.", "tokens": [51282, 383, 2450, 2196, 345, 15959, 4329, 534, 5369, 13, 51439], "avg_logprob": -0.09254086192126747, "compression_ratio": 1.5924528301886793, "no_speech_prob": 0.025908133015036583, "words": null, "temperature": 0.0}, {"id": 54, "seek": 11374, "start": 135.26000000000002, "end": 137.46, "text": " Every workload, every person,", "tokens": [51439, 3887, 26211, 11, 790, 1048, 11, 51549], "avg_logprob": -0.09254086192126747, "compression_ratio": 1.5924528301886793, "no_speech_prob": 0.025908133015036583, "words": null, "temperature": 0.0}, {"id": 55, "seek": 11374, "start": 137.46, "end": 139.96, "text": " every device carries it cryptographically.", "tokens": [51549, 790, 3335, 10732, 340, 8194, 33145, 13, 51674], "avg_logprob": -0.09254086192126747, "compression_ratio": 1.5924528301886793, "no_speech_prob": 0.025908133015036583, "words": null, "temperature": 0.0}, {"id": 56, "seek": 11374, "start": 139.96, "end": 142.58, "text": " A sensitive service simply refuses anyone", "tokens": [51674, 317, 8564, 2139, 2391, 17567, 2687, 51805], "avg_logprob": -0.09254086192126747, "compression_ratio": 1.5924528301886793, "no_speech_prob": 0.025908133015036583, "words": null, "temperature": 0.0}, {"id": 57, "seek": 14258, "start": 142.58, "end": 143.94000000000003, "text": " who has fallen out of date.", "tokens": [50363, 508, 468, 9292, 503, 286, 3128, 13, 50431], "avg_logprob": -0.09040518214219603, "compression_ratio": 1.6289752650176679, "no_speech_prob": 0.01359547395259142, "words": null, "temperature": 0.0}, {"id": 58, "seek": 14258, "start": 143.94000000000003, "end": 146.10000000000002, "text": " Zero trust, finally made real.", "tokens": [50431, 12169, 3774, 11, 3443, 925, 1103, 13, 50539], "avg_logprob": -0.09040518214219603, "compression_ratio": 1.6289752650176679, "no_speech_prob": 0.01359547395259142, "words": null, "temperature": 0.0}, {"id": 59, "seek": 14258, "start": 146.10000000000002, "end": 147.18, "text": " Failures move left.", "tokens": [50539, 18448, 942, 1445, 1364, 13, 50593], "avg_logprob": -0.09040518214219603, "compression_ratio": 1.6289752650176679, "no_speech_prob": 0.01359547395259142, "words": null, "temperature": 0.0}, {"id": 60, "seek": 14258, "start": 147.18, "end": 150.58, "text": " The cluster advertises which policy versions it accepts.", "tokens": [50593, 383, 13946, 6728, 2696, 543, 2450, 6300, 340, 18178, 13, 50763], "avg_logprob": -0.09040518214219603, "compression_ratio": 1.6289752650176679, "no_speech_prob": 0.01359547395259142, "words": null, "temperature": 0.0}, {"id": 61, "seek": 14258, "start": 150.58, "end": 152.38000000000002, "text": " Your pipeline runs the exact check", "tokens": [50763, 3406, 11523, 4539, 262, 2748, 2198, 50853], "avg_logprob": -0.09040518214219603, "compression_ratio": 1.6289752650176679, "no_speech_prob": 0.01359547395259142, "words": null, "temperature": 0.0}, {"id": 62, "seek": 14258, "start": 152.38000000000002, "end": 154.86, "text": " the cluster will offline before you merge.", "tokens": [50853, 262, 13946, 481, 18043, 878, 345, 20121, 13, 50977], "avg_logprob": -0.09040518214219603, "compression_ratio": 1.6289752650176679, "no_speech_prob": 0.01359547395259142, "words": null, "temperature": 0.0}, {"id": 63, "seek": 14258, "start": 154.86, "end": 157.68, "text": " A deploy time surprise becomes practically unheard of.", "tokens": [50977, 317, 6061, 640, 5975, 4329, 14547, 36511, 286, 13, 51118], "avg_logprob": -0.09040518214219603, "compression_ratio": 1.6289752650176679, "no_speech_prob": 0.01359547395259142, "words": null, "temperature": 0.0}, {"id": 64, "seek": 14258, "start": 157.68, "end": 160.02, "text": " The compliant path becomes the easy path.", "tokens": [51118, 383, 31332, 3108, 4329, 262, 2562, 3108, 13, 51235], "avg_logprob": -0.09040518214219603, "compression_ratio": 1.6289752650176679, "no_speech_prob": 0.01359547395259142, "words": null, "temperature": 0.0}, {"id": 65, "seek": 14258, "start": 160.02, "end": 163.34, "text": " Then it comes alive, the estate war games itself.", "tokens": [51235, 3244, 340, 2058, 6776, 11, 262, 7964, 1175, 1830, 2346, 13, 51401], "avg_logprob": -0.09040518214219603, "compression_ratio": 1.6289752650176679, "no_speech_prob": 0.01359547395259142, "words": null, "temperature": 0.0}, {"id": 66, "seek": 14258, "start": 163.34, "end": 166.02, "text": " Threat feeds, new vulnerabilities,", "tokens": [51401, 25238, 21318, 11, 649, 23805, 11, 51535], "avg_logprob": -0.09040518214219603, "compression_ratio": 1.6289752650176679, "no_speech_prob": 0.01359547395259142, "words": null, "temperature": 0.0}, {"id": 67, "seek": 14258, "start": 166.02, "end": 168.58, "text": " regulator fines, all pour in.", "tokens": [51535, 24161, 17176, 11, 477, 12797, 287, 13, 51663], "avg_logprob": -0.09040518214219603, "compression_ratio": 1.6289752650176679, "no_speech_prob": 0.01359547395259142, "words": null, "temperature": 0.0}, {"id": 68, "seek": 14258, "start": 168.58, "end": 170.46, "text": " An agent stress tests your controls", "tokens": [51663, 1052, 5797, 5503, 5254, 534, 6973, 51757], "avg_logprob": -0.09040518214219603, "compression_ratio": 1.6289752650176679, "no_speech_prob": 0.01359547395259142, "words": null, "temperature": 0.0}, {"id": 69, "seek": 17046, "start": 170.46, "end": 173.72, "text": " and asks one question, is this still proportionate", "tokens": [50363, 290, 7893, 530, 1808, 11, 318, 428, 991, 9823, 378, 50526], "avg_logprob": -0.1083829189682829, "compression_ratio": 1.62015503875969, "no_speech_prob": 0.010238563641905785, "words": null, "temperature": 0.0}, {"id": 70, "seek": 17046, "start": 173.72, "end": 175.5, "text": " or has the world quietly moved?", "tokens": [50526, 393, 468, 262, 995, 12703, 3888, 30, 50615], "avg_logprob": -0.1083829189682829, "compression_ratio": 1.62015503875969, "no_speech_prob": 0.010238563641905785, "words": null, "temperature": 0.0}, {"id": 71, "seek": 17046, "start": 175.5, "end": 178.56, "text": " When it drifts, the agent does exactly one thing.", "tokens": [50615, 1649, 340, 1553, 19265, 11, 262, 5797, 857, 3446, 530, 1517, 13, 50768], "avg_logprob": -0.1083829189682829, "compression_ratio": 1.62015503875969, "no_speech_prob": 0.010238563641905785, "words": null, "temperature": 0.0}, {"id": 72, "seek": 17046, "start": 178.56, "end": 179.98000000000002, "text": " It opens a pull request.", "tokens": [50768, 632, 9808, 257, 2834, 2581, 13, 50839], "avg_logprob": -0.1083829189682829, "compression_ratio": 1.62015503875969, "no_speech_prob": 0.010238563641905785, "words": null, "temperature": 0.0}, {"id": 73, "seek": 17046, "start": 179.98000000000002, "end": 182.9, "text": " It proposes, it never disposes.", "tokens": [50839, 632, 26017, 11, 340, 1239, 595, 4832, 13, 50985], "avg_logprob": -0.1083829189682829, "compression_ratio": 1.62015503875969, "no_speech_prob": 0.010238563641905785, "words": null, "temperature": 0.0}, {"id": 74, "seek": 17046, "start": 182.9, "end": 185.38, "text": " A human reviews, the gate checks,", "tokens": [50985, 317, 1692, 8088, 11, 262, 8946, 8794, 11, 51109], "avg_logprob": -0.1083829189682829, "compression_ratio": 1.62015503875969, "no_speech_prob": 0.010238563641905785, "words": null, "temperature": 0.0}, {"id": 75, "seek": 17046, "start": 185.38, "end": 187.22, "text": " and only then does it ship.", "tokens": [51109, 290, 691, 788, 857, 340, 4074, 13, 51201], "avg_logprob": -0.1083829189682829, "compression_ratio": 1.62015503875969, "no_speech_prob": 0.010238563641905785, "words": null, "temperature": 0.0}, {"id": 76, "seek": 17046, "start": 187.22, "end": 190.34, "text": " A powerful machine safe on your existing rails.", "tokens": [51201, 317, 3665, 4572, 3338, 319, 534, 4683, 27587, 13, 51357], "avg_logprob": -0.1083829189682829, "compression_ratio": 1.62015503875969, "no_speech_prob": 0.010238563641905785, "words": null, "temperature": 0.0}, {"id": 77, "seek": 17046, "start": 190.34, "end": 194.42000000000002, "text": " And every actor, human or machine, signs their work.", "tokens": [51357, 843, 790, 8674, 11, 1692, 393, 4572, 11, 5895, 511, 670, 13, 51561], "avg_logprob": -0.1083829189682829, "compression_ratio": 1.62015503875969, "no_speech_prob": 0.010238563641905785, "words": null, "temperature": 0.0}, {"id": 78, "seek": 17046, "start": 194.42000000000002, "end": 197.02, "text": " Cryptographically signed, publicly logged,", "tokens": [51561, 15126, 33145, 4488, 11, 7271, 18832, 11, 51691], "avg_logprob": -0.1083829189682829, "compression_ratio": 1.62015503875969, "no_speech_prob": 0.010238563641905785, "words": null, "temperature": 0.0}, {"id": 79, "seek": 17046, "start": 197.02, "end": 198.98000000000002, "text": " verifiable end to end.", "tokens": [51691, 3326, 16823, 886, 284, 886, 13, 51789], "avg_logprob": -0.1083829189682829, "compression_ratio": 1.62015503875969, "no_speech_prob": 0.010238563641905785, "words": null, "temperature": 0.0}, {"id": 80, "seek": 19898, "start": 198.98000000000002, "end": 201.70000000000002, "text": " You can prove which actor changed what, when,", "tokens": [50363, 921, 460, 5879, 543, 8674, 3421, 644, 11, 618, 11, 50499], "avg_logprob": -0.09679895561674366, "compression_ratio": 1.549090909090909, "no_speech_prob": 0.0016176198842003942, "words": null, "temperature": 0.0}, {"id": 81, "seek": 19898, "start": 201.70000000000002, "end": 204.94000000000003, "text": " and from what evidence for an AI-enabled business.", "tokens": [50499, 290, 422, 644, 2370, 329, 281, 9552, 12, 25616, 1597, 13, 50661], "avg_logprob": -0.09679895561674366, "compression_ratio": 1.549090909090909, "no_speech_prob": 0.0016176198842003942, "words": null, "temperature": 0.0}, {"id": 82, "seek": 19898, "start": 204.94000000000003, "end": 206.26000000000002, "text": " That is how you trust it.", "tokens": [50661, 1320, 318, 703, 345, 3774, 340, 13, 50727], "avg_logprob": -0.09679895561674366, "compression_ratio": 1.549090909090909, "no_speech_prob": 0.0016176198842003942, "words": null, "temperature": 0.0}, {"id": 83, "seek": 19898, "start": 206.26000000000002, "end": 208.50000000000003, "text": " So what does your funding build?", "tokens": [50727, 1406, 644, 857, 534, 4918, 1382, 30, 50839], "avg_logprob": -0.09679895561674366, "compression_ratio": 1.549090909090909, "no_speech_prob": 0.0016176198842003942, "words": null, "temperature": 0.0}, {"id": 84, "seek": 19898, "start": 208.50000000000003, "end": 213.02, "text": " Six real organizations brought to life a shared platform.", "tokens": [50839, 9699, 1103, 5745, 3181, 284, 1204, 257, 4888, 3859, 13, 51065], "avg_logprob": -0.09679895561674366, "compression_ratio": 1.549090909090909, "no_speech_prob": 0.0016176198842003942, "words": null, "temperature": 0.0}, {"id": 85, "seek": 19898, "start": 213.02, "end": 216.38000000000002, "text": " Three institutions, two regulators publishing controls", "tokens": [51065, 7683, 6712, 11, 734, 17199, 12407, 6973, 51233], "avg_logprob": -0.09679895561674366, "compression_ratio": 1.549090909090909, "no_speech_prob": 0.0016176198842003942, "words": null, "temperature": 0.0}, {"id": 86, "seek": 19898, "start": 216.38000000000002, "end": 217.62, "text": " and fines as code.", "tokens": [51233, 290, 17176, 355, 2438, 13, 51295], "avg_logprob": -0.09679895561674366, "compression_ratio": 1.549090909090909, "no_speech_prob": 0.0016176198842003942, "words": null, "temperature": 0.0}, {"id": 87, "seek": 19898, "start": 217.62, "end": 219.86, "text": " A cluster each where every core claim", "tokens": [51295, 317, 13946, 1123, 810, 790, 4755, 1624, 51407], "avg_logprob": -0.09679895561674366, "compression_ratio": 1.549090909090909, "no_speech_prob": 0.0016176198842003942, "words": null, "temperature": 0.0}, {"id": 88, "seek": 19898, "start": 219.86, "end": 221.82000000000002, "text": " is demonstrated, not slideware.", "tokens": [51407, 318, 9555, 11, 407, 27803, 29725, 13, 51505], "avg_logprob": -0.09679895561674366, "compression_ratio": 1.549090909090909, "no_speech_prob": 0.0016176198842003942, "words": null, "temperature": 0.0}, {"id": 89, "seek": 19898, "start": 221.82000000000002, "end": 223.54000000000002, "text": " And here's why this is ours to build.", "tokens": [51505, 843, 994, 338, 1521, 428, 318, 16903, 284, 1382, 13, 51591], "avg_logprob": -0.09679895561674366, "compression_ratio": 1.549090909090909, "no_speech_prob": 0.0016176198842003942, "words": null, "temperature": 0.0}, {"id": 90, "seek": 19898, "start": 223.54000000000002, "end": 225.42000000000002, "text": " Flux is not a logo on a slide.", "tokens": [51591, 1610, 2821, 318, 407, 257, 11112, 319, 257, 10649, 13, 51685], "avg_logprob": -0.09679895561674366, "compression_ratio": 1.549090909090909, "no_speech_prob": 0.0016176198842003942, "words": null, "temperature": 0.0}, {"id": 91, "seek": 22542, "start": 225.46, "end": 228.42000000000002, "text": " It is load-bearing, doing six real jobs,", "tokens": [50365, 632, 318, 3440, 12, 28655, 11, 1804, 2237, 1103, 3946, 11, 50513], "avg_logprob": -0.10894765855083542, "compression_ratio": 1.6057347670250897, "no_speech_prob": 0.11888324469327927, "words": null, "temperature": 0.0}, {"id": 92, "seek": 22542, "start": 228.42000000000002, "end": 231.98000000000002, "text": " distribution, provenance, pruning, healing, ordering,", "tokens": [50513, 6082, 11, 9157, 590, 11, 778, 46493, 11, 11516, 11, 16216, 11, 50691], "avg_logprob": -0.10894765855083542, "compression_ratio": 1.6057347670250897, "no_speech_prob": 0.11888324469327927, "words": null, "temperature": 0.0}, {"id": 93, "seek": 22542, "start": 231.98000000000002, "end": 233.10000000000002, "text": " alerts.", "tokens": [50691, 21675, 13, 50747], "avg_logprob": -0.10894765855083542, "compression_ratio": 1.6057347670250897, "no_speech_prob": 0.11888324469327927, "words": null, "temperature": 0.0}, {"id": 94, "seek": 22542, "start": 233.10000000000002, "end": 236.3, "text": " This puts Flux at the very center of the risk story,", "tokens": [50747, 770, 7584, 1610, 2821, 379, 262, 845, 3641, 286, 262, 2526, 1621, 11, 50907], "avg_logprob": -0.10894765855083542, "compression_ratio": 1.6057347670250897, "no_speech_prob": 0.11888324469327927, "words": null, "temperature": 0.0}, {"id": 95, "seek": 22542, "start": 236.3, "end": 238.38000000000002, "text": " which lets us close where no security", "tokens": [50907, 543, 8781, 514, 1969, 810, 645, 2324, 51011], "avg_logprob": -0.10894765855083542, "compression_ratio": 1.6057347670250897, "no_speech_prob": 0.11888324469327927, "words": null, "temperature": 0.0}, {"id": 96, "seek": 22542, "start": 238.38000000000002, "end": 240.98000000000002, "text": " talk ever closes, the balance sheet.", "tokens": [51011, 1561, 1683, 20612, 11, 262, 5236, 9629, 13, 51141], "avg_logprob": -0.10894765855083542, "compression_ratio": 1.6057347670250897, "no_speech_prob": 0.11888324469327927, "words": null, "temperature": 0.0}, {"id": 97, "seek": 22542, "start": 240.98000000000002, "end": 243.66000000000003, "text": " Residual risk becomes economic capital.", "tokens": [51141, 1874, 312, 723, 2526, 4329, 3034, 3139, 13, 51275], "avg_logprob": -0.10894765855083542, "compression_ratio": 1.6057347670250897, "no_speech_prob": 0.11888324469327927, "words": null, "temperature": 0.0}, {"id": 98, "seek": 22542, "start": 243.66000000000003, "end": 246.88000000000002, "text": " The very same controls an underwriter would price.", "tokens": [51275, 383, 845, 976, 6973, 281, 739, 16002, 561, 2756, 13, 51436], "avg_logprob": -0.10894765855083542, "compression_ratio": 1.6057347670250897, "no_speech_prob": 0.11888324469327927, "words": null, "temperature": 0.0}, {"id": 99, "seek": 22542, "start": 246.88000000000002, "end": 250.18, "text": " Technological risk, finally, a line your board can read,", "tokens": [51436, 5429, 2770, 2526, 11, 3443, 11, 257, 1627, 534, 3096, 460, 1100, 11, 51601], "avg_logprob": -0.10894765855083542, "compression_ratio": 1.6057347670250897, "no_speech_prob": 0.11888324469327927, "words": null, "temperature": 0.0}, {"id": 100, "seek": 22542, "start": 250.18, "end": 251.54000000000002, "text": " defend and act on.", "tokens": [51601, 4404, 290, 719, 319, 13, 51669], "avg_logprob": -0.10894765855083542, "compression_ratio": 1.6057347670250897, "no_speech_prob": 0.11888324469327927, "words": null, "temperature": 0.0}, {"id": 101, "seek": 22542, "start": 251.54000000000002, "end": 254.62, "text": " For the spend, you get three things that compound.", "tokens": [51669, 1114, 262, 4341, 11, 345, 651, 1115, 1243, 326, 13061, 13, 51823], "avg_logprob": -0.10894765855083542, "compression_ratio": 1.6057347670250897, "no_speech_prob": 0.11888324469327927, "words": null, "temperature": 0.0}, {"id": 102, "seek": 25462, "start": 254.62, "end": 257.18, "text": " A flagship talk that tours every conference,", "tokens": [50363, 317, 21336, 1561, 326, 21284, 790, 4495, 11, 50491], "avg_logprob": -0.1269156294874847, "compression_ratio": 1.630281690140845, "no_speech_prob": 0.00931769423186779, "words": null, "temperature": 0.0}, {"id": 103, "seek": 25462, "start": 257.18, "end": 260.42, "text": " a demo estate our teams put in front of any prospect,", "tokens": [50491, 257, 13605, 7964, 674, 3466, 1234, 287, 2166, 286, 597, 6034, 11, 50653], "avg_logprob": -0.1269156294874847, "compression_ratio": 1.630281690140845, "no_speech_prob": 0.00931769423186779, "words": null, "temperature": 0.0}, {"id": 104, "seek": 25462, "start": 260.42, "end": 263.94, "text": " and ownership of a story no competitor in this market", "tokens": [50653, 290, 9238, 286, 257, 1621, 645, 20319, 287, 428, 1910, 50829], "avg_logprob": -0.1269156294874847, "compression_ratio": 1.630281690140845, "no_speech_prob": 0.00931769423186779, "words": null, "temperature": 0.0}, {"id": 105, "seek": 25462, "start": 263.94, "end": 265.1, "text": " is telling yet.", "tokens": [50829, 318, 5149, 1865, 13, 50887], "avg_logprob": -0.1269156294874847, "compression_ratio": 1.630281690140845, "no_speech_prob": 0.00931769423186779, "words": null, "temperature": 0.0}, {"id": 106, "seek": 25462, "start": 265.1, "end": 266.98, "text": " And the timing is the whole point.", "tokens": [50887, 843, 262, 10576, 318, 262, 2187, 966, 13, 50981], "avg_logprob": -0.1269156294874847, "compression_ratio": 1.630281690140845, "no_speech_prob": 0.00931769423186779, "words": null, "temperature": 0.0}, {"id": 107, "seek": 25462, "start": 266.98, "end": 269.86, "text": " Every board is asking how to trust AI", "tokens": [50981, 3887, 3096, 318, 4737, 703, 284, 3774, 9552, 51125], "avg_logprob": -0.1269156294874847, "compression_ratio": 1.630281690140845, "no_speech_prob": 0.00931769423186779, "words": null, "temperature": 0.0}, {"id": 108, "seek": 25462, "start": 269.86, "end": 271.12, "text": " inside their business.", "tokens": [51125, 2641, 511, 1597, 13, 51188], "avg_logprob": -0.1269156294874847, "compression_ratio": 1.630281690140845, "no_speech_prob": 0.00931769423186779, "words": null, "temperature": 0.0}, {"id": 109, "seek": 25462, "start": 271.12, "end": 274.5, "text": " We answer it provably, on stage, in pounds.", "tokens": [51188, 775, 3280, 340, 899, 1346, 11, 319, 3800, 11, 287, 8059, 13, 51357], "avg_logprob": -0.1269156294874847, "compression_ratio": 1.630281690140845, "no_speech_prob": 0.00931769423186779, "words": null, "temperature": 0.0}, {"id": 110, "seek": 25462, "start": 274.5, "end": 276.86, "text": " Whoever tells this story first owns it,", "tokens": [51357, 37807, 4952, 428, 1621, 717, 12216, 340, 11, 51475], "avg_logprob": -0.1269156294874847, "compression_ratio": 1.630281690140845, "no_speech_prob": 0.00931769423186779, "words": null, "temperature": 0.0}, {"id": 111, "seek": 25462, "start": 276.86, "end": 278.78000000000003, "text": " and that window is open right now.", "tokens": [51475, 290, 326, 4324, 318, 1280, 826, 783, 13, 51571], "avg_logprob": -0.1269156294874847, "compression_ratio": 1.630281690140845, "no_speech_prob": 0.00931769423186779, "words": null, "temperature": 0.0}, {"id": 112, "seek": 25462, "start": 278.78000000000003, "end": 279.94, "text": " So here's the ask.", "tokens": [51571, 1406, 994, 338, 262, 1265, 13, 51629], "avg_logprob": -0.1269156294874847, "compression_ratio": 1.630281690140845, "no_speech_prob": 0.00931769423186779, "words": null, "temperature": 0.0}, {"id": 113, "seek": 25462, "start": 279.94, "end": 282.06, "text": " Fund the full build every step", "tokens": [51629, 7557, 262, 1336, 1382, 790, 2239, 51735], "avg_logprob": -0.1269156294874847, "compression_ratio": 1.630281690140845, "no_speech_prob": 0.00931769423186779, "words": null, "temperature": 0.0}, {"id": 114, "seek": 25462, "start": 282.06, "end": 283.64, "text": " through to the flagship talk.", "tokens": [51735, 832, 284, 262, 21336, 1561, 13, 51814], "avg_logprob": -0.1269156294874847, "compression_ratio": 1.630281690140845, "no_speech_prob": 0.00931769423186779, "words": null, "temperature": 0.0}, {"id": 115, "seek": 28364, "start": 283.68, "end": 284.9, "text": " Give me that runway.", "tokens": [50365, 13786, 502, 326, 23443, 13, 50426], "avg_logprob": -0.15664393183859912, "compression_ratio": 1.264, "no_speech_prob": 0.009353543631732464, "words": null, "temperature": 0.0}, {"id": 116, "seek": 28364, "start": 284.9, "end": 286.76, "text": " And I'll hand you the estate that proves governance", "tokens": [50426, 843, 314, 1183, 1021, 345, 262, 7964, 326, 17021, 18848, 50519], "avg_logprob": -0.15664393183859912, "compression_ratio": 1.264, "no_speech_prob": 0.009353543631732464, "words": null, "temperature": 0.0}, {"id": 117, "seek": 28364, "start": 286.76, "end": 289.68, "text": " can finally be proportionate, honest, and alive.", "tokens": [50519, 460, 3443, 307, 9823, 378, 11, 5508, 11, 290, 6776, 13, 50665], "avg_logprob": -0.1