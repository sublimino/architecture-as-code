{
  "name": "init-container-securitycontext-empty",
  "level": "unit",
  "description": "An initContainer with securityContext: {}.",
  "input": {
    "object": {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "init-container-securitycontext-empty",
        "namespace": "payments"
      },
      "spec": {
        "automountServiceAccountToken": false,
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 10001,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "app",
            "image": "registry.example/app@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "ports": [
              {
                "name": "http",
                "containerPort": 8080,
                "protocol": "TCP"
              }
            ],
            "env": [
              {
                "name": "LOG_LEVEL",
                "value": "info"
              }
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            }
          }
        ],
        "volumes": [
          {
            "name": "tmp",
            "emptyDir": {}
          }
        ],
        "initContainers": [
          {
            "name": "init",
            "image": "registry.example/init@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "securityContext": {}
          }
        ]
      }
    },
    "agent": {},
    "request": {}
  },
  "expect": {
    "sa-token-automount-disabled": "pass",
    "no-privileged-containers": "pass",
    "no-host-pid": "pass",
    "no-host-ipc": "pass",
    "no-host-network": "pass",
    "no-privilege-escalation": "fail",
    "no-root-containers": "pass",
    "no-net-raw": "fail",
    "no-added-capabilities": "pass",
    "capabilities-dropped-all": "fail",
    "no-windows-hostprocess": "pass",
    "no-hostpath-volumes": "pass",
    "no-host-ports": "pass",
    "no-secrets-in-env": "pass",
    "seccomp-runtime-default": "pass",
    "security-context-applied": "fail",
    "no-default-namespace": "pass"
  }
}
