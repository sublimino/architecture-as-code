{
  "name": "enterprise-rag-assistant-fully-governed",
  "level": "integration",
  "description": "Internal research assistant over a policy corpus: RAG with ingestion PII filtering, firewall both directions, pinned model, SSO + RBAC, encrypted stores, scoped read-only tools, allow-listed MCP via proxy, JIT credentials, audit and spend controls. Every check passes.",
  "input": {
    "object": {},
    "agent": {
      "id": "agent-7f3c",
      "name": "policy-research-assistant",
      "owner": "risk-engineering",
      "status": "active",
      "registry": {
        "model_registered": true,
        "model_provider": "anthropic",
        "model_name": "claude-sonnet-4-5",
        "model_version": "claude-sonnet-4-5-20250929",
        "approved_by": "model-risk-committee"
      },
      "guardrails": {
        "prompt_injection_filter": true,
        "output_filter": true,
        "provider": "ai-firewall-gw"
      },
      "data": {
        "rag_enabled": true,
        "ingestion_sensitive_data_filter": true,
        "knowledge_bases": [
          "policy-library",
          "procedures"
        ],
        "persistent_stores": [
          {
            "name": "pgvector-policy-index",
            "kind": "vector",
            "encrypted_at_rest": true,
            "kms_key": "kms://risk/aigf"
          },
          {
            "name": "conversation-store",
            "kind": "postgres",
            "encrypted_at_rest": true,
            "kms_key": "kms://risk/aigf"
          }
        ]
      },
      "rate_limits": {
        "requests_per_minute": 300,
        "tokens_per_minute": 400000
      },
      "access": {
        "authentication_required": true,
        "rbac_enforced": true,
        "idp": "oidc://sso.example.bank"
      },
      "tools": [
        {
          "name": "search_policies",
          "scopes": [
            "kb:policy:read"
          ],
          "impact": "low"
        },
        {
          "name": "open_jira_ticket",
          "scopes": [
            "jira:project:RISK:create"
          ],
          "impact": "medium"
        }
      ],
      "mcp_servers": [
        {
          "name": "confluence-mcp",
          "url": "https://mcp-proxy.internal/confluence",
          "allowlisted": true
        }
      ],
      "credentials": {
        "long_lived_secrets_exposed": false,
        "delivery": "workload-identity"
      },
      "observability": {
        "audit_logging": true,
        "sink": "splunk://ai-audit"
      },
      "cost_controls": {
        "budget_limit": 12000,
        "spend_alerting": true,
        "alert_thresholds": [
          0.5,
          0.75,
          0.9
        ]
      },
      "governance": {
        "decision_explainability": true,
        "audit_log_tamper_evident": true
      }
    },
    "request": {}
  },
  "expect": {
    "rag-ingestion-sensitive-data-filtered": "pass",
    "prompt-injection-guardrail-active": "pass",
    "output-leakage-filter-active": "pass",
    "inference-rate-limit-configured": "pass",
    "registered-model-registry-entry": "pass",
    "model-version-pinned": "pass",
    "user-authn-and-rbac-enforced": "pass",
    "ai-data-encrypted-at-rest": "pass",
    "tool-grants-least-privilege": "pass",
    "mcp-servers-allowlisted": "pass",
    "no-long-lived-credentials-exposed": "pass",
    "high-impact-actions-human-approved": "pass",
    "ai-interaction-audit-logging": "pass",
    "spend-budget-alerting-configured": "pass",
    "decision-explainability-metadata": "pass",
    "decision-audit-tamper-evident": "pass"
  }
}
