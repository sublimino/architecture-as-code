        "cellHeight": "md",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_OLLY-PROMETHEUS}"
          },
          "expr": "100 * sum by (app_id) (rate(tenant_app_requests_total{code=\"500\"}[5m])) / clamp_min(sum by (app_id) (rate(tenant_app_requests_total[5m])), 0.001)",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_OLLY-PROMETHEUS}"
          },
          "expr": "max by (app_id) (tenant_app_up)",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_OLLY-PROMETHEUS}"
          },
          "expr": "min by (app_id) (tenant_app_upstream_up)",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_OLLY-PROMETHEUS}"
          },
          "expr": "time() - max by (app_id) (timestamp(tenant_app_up))",
          "format": "table",
          "instant": true,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_OLLY-PROMETHEUS}"
          },
          "expr": "1000 * max by (app_id) (timestamp(tenant_app_up))",
          "format": "table",
          "instant": true,
          "refId": "I"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_OLLY-PROMETHEUS}"
          },
          "expr": "sum by (app_id) (rate(tenant_app_request_duration_seconds_sum[5m])) / clamp_min(sum by (app_id) (rate(tenant_app_request_duration_seconds_count[5m])), 0.001)",
          "format": "table",
          "instant": true,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_OLLY-PROMETHEUS}"
          },
          "expr": "sum by (app_id) (ALERTS{alertstate=\"firing\", app_id!=\"\"}) or (max by (app_id)(tenant_app_up) * 0)",
          "format": "table",
          "instant": true,
          "refId": "F"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_OLLY-PROMETHEUS}"
          },
          "expr": "sum by (app_id) (olly_incidents) and on (app_id) tenant_app_up",
          "format": "table",
          "instant": true,
          "refId": "G"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_OLLY-PROMETHEUS}"
          },
          "expr": "max by (app_id) (tenant_app_up)",
          "format": "table",
          "instant": true,
          "refId": "H"
        }
      ],
      "title": "Applications",
