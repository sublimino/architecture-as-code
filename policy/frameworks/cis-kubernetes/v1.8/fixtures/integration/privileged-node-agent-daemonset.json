{
  "name": "privileged-node-agent-daemonset",
  "level": "integration",
  "description": "Privileged node-agent DaemonSet pod (CNI/monitoring style): hostNetwork, hostPID, hostPath mounts, NET_ADMIN, privileged init.",
  "input": {
    "object": {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "node-agent-x2k9p",
        "namespace": "kube-system",
        "labels": {
          "k8s-app": "node-agent"
        }
      },
      "spec": {
        "serviceAccountName": "node-agent",
        "hostNetwork": true,
        "hostPID": true,
        "dnsPolicy": "ClusterFirstWithHostNet",
        "tolerations": [
          {
            "operator": "Exists"
          }
        ],
        "initContainers": [
          {
            "name": "install-cni",
            "image": "registry.example/node-agent@sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
            "securityContext": {
              "privileged": true
            },
            "volumeMounts": [
              {
                "name": "cni-bin",
                "mountPath": "/host/opt/cni/bin"
              }
            ]
          }
        ],
        "containers": [
          {
            "name": "agent",
            "image": "registry.example/node-agent@sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
            "ports": [
              {
                "name": "health",
                "containerPort": 9099
              }
            ],
            "env": [
              {
                "name": "NODE_NAME",
                "valueFrom": {
                  "fieldRef": {
                    "fieldPath": "spec.nodeName"
                  }
                }
              }
            ],
            "securityContext": {
              "runAsUser": 0,
              "capabilities": {
                "add": [
                  "NET_ADMIN",
                  "SYS_ADMIN",
                  "NET_RAW"
                ]
              }
            },
            "volumeMounts": [
              {
                "name": "proc",
                "mountPath": "/host/proc",
                "readOnly": true
              },
              {
                "name": "run",
                "mountPath": "/var/run/agent"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "cni-bin",
            "hostPath": {
              "path": "/opt/cni/bin"
            }
          },
          {
            "name": "proc",
            "hostPath": {
              "path": "/proc"
            }
          },
          {
            "name": "run",
            "hostPath": {
              "path": "/var/run/agent",
              "type": "DirectoryOrCreate"
            }
          }
        ]
      }
    },
    "agent": {},
    "request": {}
  },
  "expect": {
    "sa-token-automount-disabled": "fail",
    "no-privileged-containers": "fail",
    "no-host-pid": "fail",
    "no-host-ipc": "pass",
    "no-host-network": "fail",
    "no-privilege-escalation": "fail",
    "no-root-containers": "fail",
    "no-net-raw": "fail",
    "no-added-capabilities": "fail",
    "capabilities-dropped-all": "fail",
    "no-windows-hostprocess": "pass",
    "no-hostpath-volumes": "fail",
    "no-host-ports": "fail",
    "no-secrets-in-env": "pass",
    "seccomp-runtime-default": "fail",
    "security-context-applied": "fail",
    "no-default-namespace": "pass"
  }
}
