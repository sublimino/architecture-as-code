      "sentinelEnd": "# <<< SLSI-P2-2 >>>",
      "stageFunctionName": "stage_p2_2_hostmounts",
      "responsibility": "Generates Kind node cluster configuration with combined host storage mounts and kernel telemetry paths, initializes host persistence directories with correct POSIX ownership",
